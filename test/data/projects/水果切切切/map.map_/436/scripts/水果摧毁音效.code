name:水果摧毁音效
params:Float 音量
lines:
Long $rand=fun long.rand(Long 0:Long 29)
Bool bool1=fun long.gte(var $rand:Long 0)
Bool bool2=fun long.lt(var $rand:Long 3)
if{fun bool.and(var bool1:var bool2)
  act 1101./主界面.播放音效(String 水果爆炸1.ogg:var 音量)
}
