  Float 粒子1_1620s=fun float.multiply(Float 0.06:var 整体缩放)
  Float 粒子2_1620s=fun float.multiply(Float 0.06:var 整体缩放)
  Float 粒子数1_1620s=fun create.float(Float 10)
