color:65,0,255
name:_1330
params:Vector3 坐标,Float 整体缩放,Long 摧毁模式
lines:
if{fun long.equal(var 摧毁模式:Long 0)
  Color 颜色1=fun create.color(Color 255,244,0,255,颜色1330_0)
  Color 颜色2=fun create.color(Color 255,255,235,255,颜色1330_1)
  if{fun bool.not(var 简化特效生效)
    Float 特效缩放=fun float.multiply(Float 0.025:var 整体缩放)
    act 336./特效发射器.发射(var 坐标:Float 46:var 特效缩放)
  }
  Float 粒子1_1300s=fun float.multiply(Float 0.06:var 整体缩放)
  Float 粒子2_1300s=fun float.multiply(Float 0.06:var 整体缩放)
  Float 粒子数1_1300s=fun create.float(Float 8)
  Float 粒子数2_1300s=fun create.float(Float 20)
  act 336./碎片粒子发射器.发射碎片(var 坐标:var 粒子1_1300s:var 粒子数1_1300s:var 颜色1:Float 5:var 简化特效生效)
  act 336./碎片粒子发射器.发射碎片(var 坐标:var 粒子2_1300s:var 粒子数2_1300s:var 颜色2:Float 5:var 简化特效生效)
  Float 粒子3_1300s=fun float.multiply(Float 1.7:var 整体缩放)
  act 336./果汁地面粒子发射器.发射果汁贴图(var 坐标:var 粒子3_1300s:var 颜色2:var 简化特效生效)
  act 1101.this.水果摧毁音效(Float 1.15)
}
if{fun long.equal(var 摧毁模式:Long 1)
  if{fun bool.not(var 简化特效生效)
    Float 特效缩放=fun float.multiply(Float 0.07:var 整体缩放)
    act 336./特效发射器.发射(var 坐标:Float 67:var 特效缩放)
  }
  act 1101.this.水果摧毁音效(Float 1.15)
}
endcode