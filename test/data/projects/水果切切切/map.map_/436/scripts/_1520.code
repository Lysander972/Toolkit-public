lines:
if{fun bool.not(var 简化特效生效)
  fun screen.shake(Float 0.2:Float 500:Float 0.7)
}
Float 特效缩放=fun float.multiply(Float 0.15:var 整体缩放)
if{fun long.equal(var 摧毁模式:Long 0)
  act 336./特效发射器.发射(var 坐标:Float 22:var 特效缩放)
  act 1101./主界面.播放音效(String 煤气罐爆炸.ogg:Float 1)
}
