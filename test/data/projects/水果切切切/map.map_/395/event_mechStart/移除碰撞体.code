name:移除碰撞体
lines:
Mech obj=act 1.this.getMech()
Float total=varf Mech.obj.deviceNum()
Float index=fun create.float(Float 0)
while{fun float.lt(var index:var total)
  Device dev=varf Mech.obj.getDevice(var index)
  varf Device.dev.switchCollider(Bool 0)
  varf Float.index.addEqual(Float 1)
}
endcode