  //@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3
  while{fun float.lt(var 列表编号_横:var 循环次数_横)
    Long 对象层序号ID=varf Float.列表编号_横.toLong()
    //@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3@3
    String 列名=fun create.string(var 对象层序号ID)
    Bool 布尔_碰撞开关=fun readExcel2_Bool(var 对象层序号_整数:var 列名:String 碰撞层级设置)
    fun layer.enableCollide(var 列表编号_纵:var 列表编号_横:var 布尔_碰撞开关)
