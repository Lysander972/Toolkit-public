begincodeV2
name:设置排名
params:Long rank,Struct player
lines:
Long team=varf Struct.player.getLong(String team:Bool 1)
Canvas 主UI=fun findCanvas(String 主UI)
UIRect layer1=varf Canvas.主UI.readUIRect(String root/layer2)
fun ui.2dmode(Bool 1:Float 0)
Canvas 特效UI=fun create.canvas(Canvas canvas@1@)
UIRect back=varf Canvas.特效UI.readUIRect(String back)
varf UIRect.layer1.addSon(var back)
UILabel nick=varf Canvas.特效UI.readUILabel(String back/front/nick)
String name=varf Struct.player.getString(String name:Bool 1)
varf UILabel.nick.text(var name)
String uid=varf Struct.player.getString(String id:Bool 1)
UIRect avatar=varf Canvas.特效UI.readUIRect(String back/front/avatar/mask)
UIRawImage avatarICon=fun ui.newDanmuAvatar(Vector3 0.5,0.5,0:Float 70:var uid)
varf UIRect.avatar.addSon(var avatarICon)
varf UIRawImage.avatarICon.setCanvasPos(Vector3 0,0,0)
UILabel Ranklabel=varf Canvas.特效UI.readUILabel(String back/rank/label)
Long 名次=fun long.add(var rank:Long 1)
String w=fun string.add(String 世界排名 :var 名次)
varf UILabel.Ranklabel.text(var w)
if{fun long.equal(var team:Long 1)
  UILabel join=varf Canvas.特效UI.readUILabel(String back/front/join)
  varf UILabel.join.text(String 加入上方)
  varf UILabel.join.setColor(Color 0,151,205,255,UI-蓝色)
}
if{fun long.equal(var team:Long 2)
  UILabel join=varf Canvas.特效UI.readUILabel(String back/front/join)
  varf UILabel.join.text(String 加入下方)
  varf UILabel.join.setColor(Color 255,26,0,255,UI-红色)
}
//区分排名
/*Bool 级别1=fun long.equal(var rank:Long 0)
/*Bool 级别2=fun long.lte(var rank:Long 2)
/*Bool 级别3=fun long.lte(var rank:Long 19)
/*Bool 级别4=fun long.gte(var rank:Long 20)
if{fun long.gt(var rank:Long 0)
  UIRawImage ui1=varf Canvas.特效UI.readUIRawImage(String back/top)
  varf UIRawImage.ui1.active(Bool 0)
  UIRawImage ui1=varf Canvas.特效UI.readUIRawImage(String back/leftWing)
  varf UIRawImage.ui1.active(Bool 0)
  UIRawImage ui1=varf Canvas.特效UI.readUIRawImage(String back/rightWing)
  varf UIRawImage.ui1.active(Bool 0)
  UIRawImage ui1=varf Canvas.特效UI.readUIRawImage(String back/rightBottom)
  varf UIRawImage.ui1.active(Bool 0)
  UIRawImage ui1=varf Canvas.特效UI.readUIRawImage(String back/leftBottom)
  varf UIRawImage.ui1.active(Bool 0)
}
if{fun long.gt(var rank:Long 2)
  UIRawImage ui1=varf Canvas.特效UI.readUIRawImage(String back/rightFlag)
  varf UIRawImage.ui1.active(Bool 0)
  UIRawImage ui1=varf Canvas.特效UI.readUIRawImage(String back/leftFlag)
  varf UIRawImage.ui1.active(Bool 0)
}
if{fun long.gt(var rank:Long 19)
  UIRawImage ui1=varf Canvas.特效UI.readUIRawImage(String back/bottom)
  varf UIRawImage.ui1.active(Bool 0)
}
//注册动图维护表
UIRawImage 动图=varf Canvas.特效UI.readUIRawImage(String back/icon)
Long 组号=act 1.this.callClientMapRetLongFunc1(String 弹幕.动图'计算组编号:var rank)
act 1.this.callMapFunc2(String 弹幕.动图'应用动图:var 动图:var 组号)
//开始播放动画
=act 1.this.入场动图(var rank)
delay fun create.float(Float 2)
//动画播放结束
varf UIRect.back.del(Float 0)
Mech M=act 1.this.getMech()
varf Mech.M.Del(Float 0)
endcode