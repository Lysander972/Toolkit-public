if{fun bool.and(var bool1:var bool2)
  varf Long.时间控制'慢镜头ID.addEqual(Long 1)
  String key=fun create.string(var 时间控制'慢镜头ID)
  varf Dict.时间控制'慢镜头信息.insert(var key:var 慢镜头倍数)
  act 1101.this.时间控制'更新时间流速()
}
