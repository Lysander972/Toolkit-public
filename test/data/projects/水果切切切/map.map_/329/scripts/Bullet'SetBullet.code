begincodeV2
color:104,0,255
name:Bullet'SetBullet
comment:设置一个普通子弹
params:Vector3 pos,Vector3 direction,Long type,Long faction,Struct player,Float HPMul,Float 额外暴击率,Float initHp,Float manualSpeed
return:Bool success
lines:
String bulletKey=fun create.string(var type)
//得到子弹id模型id和组id
Struct info=varf Struct.Bullet'RegInfo.getStruct(var bulletKey:Bool 0)
String modelKey=varf Struct.info.getString(String modelKey:Bool 0)
String group=varf Struct.info.getString(String group:Bool 0)
//读取组信息
Struct groupInfo=varf Struct.Bullet'GroupInf.getStruct(var group:Bool 0)
Long teamLimit=varf Struct.groupInfo.getLong(String teamLimit:Bool 0)
Long team1Current=varf Struct.groupInfo.getLong(String team1Current:Bool 0)
Long team2Current=varf Struct.groupInfo.getLong(String team2Current:Bool 0)
Long globalLimit=varf Struct.groupInfo.getLong(String globalLimit:Bool 0)
Long globalCurrent=varf Struct.groupInfo.getLong(String globalCurrent:Bool 0)
Bool b1=fun create.bool(Bool 0)
if{fun long.equal(var faction:Long 1)
  Long temp=fun long.add(var team1Current:Long 1)
  Bool b1=fun long.lte(var temp:var teamLimit)
  Bool b2=fun long.equal(var teamLimit:Long -1)
  Bool b1=fun bool.or(var b1:var b2)
}
if{fun long.equal(var faction:Long 2)
  Long temp=fun long.add(var team2Current:Long 1)
  Bool b1=fun long.lte(var temp:var teamLimit)
  Bool b2=fun long.equal(var teamLimit:Long -1)
  Bool b1=fun bool.or(var b1:var b2)
}
Long temp=fun long.add(var globalCurrent:Long 1)
Bool b3=fun long.lte(var temp:var globalLimit)
Bool b4=fun long.equal(var globalLimit:Long -1)
Bool b2=fun bool.or(var b3:var b4)
Bool success=fun bool.and(var b1:var b2)
if{fun create.bool(var success)
  List unusedList=varf Struct.Bullet'Unused.getList(var modelKey:Bool 0)
  Float index=varf List.unusedList.count()
  Bool exist=fun float.gt(var index:Float 0)
  if{fun create.bool(var exist)
    varf Float.index.minusEqual(Float 1)
    Mech obj=varf List.unusedList.readMech(var index)
    varf List.unusedList.remove(var index)
  }
  if{fun bool.not(var exist)
    Mech obj=act 1101.this.Bullet'New(var modelKey:var pos:var direction:var faction)
    varf Mech.obj.setActive(Bool 0)
  }
  Device core=varf Mech.obj.getCoreDevice()
  Vector3 向前=fun vector3.multilply(var direction:Float -1)
  varf Device.core.setPosKinematic(var pos)
  varf Device.core.setRotKinematic(var 向前:Vector3 0,1,0)
  varf Mech.obj.setActive(Bool 1)
  varf Device.core.setPosKinematic(var pos)
  varf Device.core.setRotKinematic(var 向前:Vector3 0,1,0)
  act 1101.this.Generic'BulletInitialize(var obj:var pos:var direction:var type:var faction:var player:var HPMul:var 额外暴击率:var initHp:var manualSpeed)
  varf Long.globalCurrent.addEqual(Long 1)
  if{fun long.equal(var faction:Long 1)
    varf Long.team1Current.addEqual(Long 1)
  }
  if{fun long.equal(var faction:Long 2)
    varf Long.team2Current.addEqual(Long 1)
  }
  //写入列表记录
  if{fun long.equal(var faction:Long 1)
    act 1101.this.瞄准'添加候选(var obj)
  }
}
endcode