begincodeV2
color:8,0,255
name:Public'Damage
comment:计算伤害并按需要回收
params:Float damage,Long faction
return:Float counter
lines:
if{fun long.equal(var faction:var Attr'Faction)
  fun break()
}
Float hp=fun create.float(var Attr'HP)
//预先计算反击伤害
Float counter=fun create.float(Float 0)
if{fun float.gte(var hp:var damage)
  Float counter=fun create.float(var damage)
}
if{fun float.lt(var hp:var damage)
  Float counter=fun create.float(var hp)
}
Float hp=fun float.minus(var hp:var damage)
act 1.this.Private'UpdateHP(var hp)
endcode