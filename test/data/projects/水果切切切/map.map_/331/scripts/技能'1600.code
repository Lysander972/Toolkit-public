if{act 1.this.Skills'GreaterOrEqual(var key:Long 1)
  Long rand=fun long.rand(Long 0:Long 0)
  if{fun long.equal(var rand:Long 0)
    Bool success=act 1.this.Launcher'攻方贴脸放置(Long 1610:var 属性'玩家:Vector3 0,0,-1:Float 1:Float 0:Float 1)
  }
  if{fun create.bool(var success)
    =act 1.this.Skills'Decrease(var key:Long 1)
  }
}
