        if{fun bool.and(var bool1:var bool2)
          =act 1.this.Launcher'攻方出生点放置(var 随机放置:Long 1017:var 属性'玩家:Float 1:Float 0:var 血量倍数)
        }
        //柠檬
        Bool bool1=fun float.gte(var 大型水果随机:Float 0.6)
