        Bool bool2=fun long.gte(var 小型水果随机:Long 46)
        if{fun bool.and(var bool1:var bool2)
          =act 1.this.Launcher'攻方出生点放置(var 随机放置:Long 1002:var 属性'玩家:var 血量倍数:Float 0:Float 1)
        }
        Bool bool1=fun long.lt(var 小型水果随机:Long 105)
        Bool bool2=fun long.gte(var 小型水果随机:Long 90)
        if{fun bool.and(var bool1:var bool2)
          =act 1.this.Launcher'攻方出生点放置(var 随机放置:Long 1003:var 属性'玩家:var 血量倍数:Float 0:Float 1)
        }
