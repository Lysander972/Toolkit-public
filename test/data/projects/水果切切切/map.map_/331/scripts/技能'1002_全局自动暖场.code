        Bool bool2=fun long.gte(var 小型水果随机:Long 105)
        if{fun bool.and(var bool1:var bool2)
          =act 1.this.Launcher'攻方出生点放置(var 随机放置:Long 1004:var 属性'玩家:var 血量倍数:Float 0:Float 1)
        }
      }
      if{fun float.gte(var 水果大类随机:Float 0.8)
        Float 大型水果随机=fun math.rand(Float 0:Float 1)
        //大型水果,占据刷新的主体
        //蓝色无花果
        Bool bool1=fun float.gte(var 大型水果随机:Float 0)
        Bool bool2=fun float.lt(var 大型水果随机:Float 0.05)
        if{fun bool.and(var bool1:var bool2)
          =act 1.this.Launcher'攻方出生点放置(var 随机放置:Long 1010:var 属性'玩家:Float 1:Float 0:var 血量倍数)
        }
