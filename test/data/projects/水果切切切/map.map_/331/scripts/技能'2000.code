//如果开启增强则额外加倍伤害和血量
if{fun create.bool(var 效果有效)
  Long 弹药id=fun create.long(Long 2001)
  varf Long.发射数.addEqual(Long 2)
}
//是否足够一次发射,避免持续卡死
if{fun long.gte(var 剩余弹药数:var 判定阈值)
  Float cd=fun create.float(var 属性'守方冷却)
  =act 1.this.Launcher'LaunchUniformlyAuto(var 弹药id:var 当前瞄准'X修正:var 当前瞄准'Y:var 发射数:Float 2:Float 7:Bool 0:var key:var 弹药基数:var hp基数:var 属性'守方暴击率:Float 1:Bool 0:Float 0)
  if{fun create.bool(var 冰冻'冰冻)
    Float cd=fun float.multiply(var cd:Float 2)
  }
  act 1.this.UI'守方刷新弹药数()
}
delay fun create.float(var cd)
