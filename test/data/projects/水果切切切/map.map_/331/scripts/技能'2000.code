if{fun bool.not(var 当前瞄准'有目标)
  fun break()
}
String key=fun create.string(String 2000)
Float 当前=fun time.scaleTime()
Bool 效果有效=fun float.gte(var 属性'射速加强持续:var 当前)
Long 剩余弹药数=act 1.this.Skills'GetValue(var key)
//减半消耗,加倍消耗以及强化攻击
//默认消耗2发
Long 弹药基数=fun create.long(Long 1)
Float hp基数=fun create.float(Float 1)
Long 判定阈值=fun create.long(Long 1)
Long 弹药id=fun create.long(Long 2000)
Long 发射数=fun create.long(var 属性'守方发射数)
//5000
Bool 增加消耗=fun long.gte(var 剩余弹药数:Long 10000)
if{fun create.bool(var 增加消耗)
  Long 弹药基数=fun create.long(Long 3)
  Float hp基数=fun create.float(Float 1.5)
}
