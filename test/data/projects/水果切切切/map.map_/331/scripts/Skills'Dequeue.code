name:Skills'Dequeue
params:String key
return:Struct player
lines:
Long current=varf Struct.SkillCount.getLong(var key:Bool 0)
varf Long.current.minusEqual(Long 1)
List playerList=varf Struct.SkillPlayer.getList(var key:Bool 0)
List playerCList=varf Struct.SkillPlayerC.getList(var key:Bool 0)
Struct player=varf List.playerList.readStruct(Float 0)
Long playerC=varf List.playerCList.readLong(Float 0)
varf Long.playerC.minusEqual(Long 1)
if{fun long.lte(var playerC:Long 0)
  varf List.playerList.remove(Float 0)
  varf List.playerCList.remove(Float 0)
}
if{fun long.gt(var playerC:Long 0)
  varf List.playerCList.replace(Float 0:var playerC)
}
