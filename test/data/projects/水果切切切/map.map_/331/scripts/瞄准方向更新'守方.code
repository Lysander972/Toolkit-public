  Vector3 pos=varf Device.core.callReturnVector30(String Public'GetCenter)
  Vector3 pos=fun vector3.add(var pos:Vector3 0,0,-3)
  Vector3 方位角=act 1.this.Utils'世界坐标转局部方位角(var pos)
  Float 当前瞄准'X=varf Vector3.方位角.x()
