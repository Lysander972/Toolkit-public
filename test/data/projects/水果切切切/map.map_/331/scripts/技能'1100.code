String $key=fun create.string(String 1100)
if{act 1.this.Skills'GreaterOrEqual(var $key:Long 1)
  Long 尝试次数=fun create.long(Long 0)
  while{fun long.lt(var 尝试次数:Long 30)
    Bool 可释放=act 1.this.Skills'GreaterOrEqual(var $key:Long 1)
    if{fun create.bool(var 可释放)
      Long $position=fun long.rand(Long 1:Long 13)
      Long $rand=fun long.rand(Long 0:Long 2)
      if{fun long.equal(var $rand:Long 0)
        Bool $success=act 1.this.Launcher'攻方出生点放置(var $position:Long 1100:var 属性'玩家:Float 1:Float 0:Float 1)
      }
/*      if{fun long.equal(var $rand:Long 1)
/*        Bool $success=act 1.this.Launcher'攻方出生点放置(var $position:Long 1110:var 属性'玩家:Float 1:Float 0:Float 1)
      }
      if{fun long.equal(var $rand:Long 1)
        Bool $success=act 1.this.Launcher'攻方出生点放置(var $position:Long 1120:var 属性'玩家:Float 1:Float 0:Float 1)
      }
      if{fun long.equal(var $rand:Long 2)
        Bool $success=act 1.this.Launcher'攻方出生点放置(var $position:Long 1130:var 属性'玩家:Float 1:Float 0:Float 1)
      }
      if{fun create.bool(var $success)
        =act 1.this.Skills'Decrease(var $key:Long 1)
      }
    }
    if{fun bool.not(var 可释放)
      fun break()
    }
    if{fun bool.not(var $success)
      fun break()
    }
    varf Long.尝试次数.addEqual(Long 1)
  }
}
delay fun create.float(Float 0.1)
