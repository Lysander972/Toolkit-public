color:221,0,255
name:技能'2910
comment:机枪
lines:
String key=fun create.string(String 2910)
if{act 1.this.Skills'GreaterOrEqual(var key:Long 1)
  Float cd=fun create.float(Float 0.1)
  if{fun create.bool(var 冰冻'冰冻)
    Float cd=fun float.multiply(var cd:Float 2)
  }
  //检测前摇是否已播放
  Float 当前时间=fun time.scaleTime()
  Bool 显示模型=fun float.lt(var 当前时间:var 炮塔模型'结束时间)
  if{fun bool.not(var 显示模型)
    Float 炮塔模型'开始时间=fun create.float(var 当前时间)
    Float 炮塔模型'炮塔角度=fun create.float(Float 0)
  }
  //刷新结束时间
  Float 炮塔模型'结束时间=fun float.add1(var 当前时间:Float 2:var cd)
  if{fun bool.not(var 当前瞄准'有目标)
    fun break()
  }
  Float 已用时间=fun float.minus(var 当前时间:var 炮塔模型'开始时间)
  if{fun float.gte(var 已用时间:Float 2)
    Float 随机散布=fun math.rand(Float 2:Float 2)
    Float 修正方向=fun float.add(var 炮塔模型'炮塔角度:var 随机散布)
    Vector3 方位角=fun creatVariable.Vector3(var 修正方向:Float 0:Float 0)
    Vector3 向前局部方向=act 1.this.Utils'AzimuthToVector(var 方位角)
    Vector3 局部坐标偏移=varf Vector3.向前局部方向.copy()
    Vector3 子弹局部坐标偏移=varf Vector3.局部坐标偏移.setLength(Float 3)
    //计算每个弹道
    Vector3 正右=act 1.this.localToWorldDir(Vector3 0.2,0,0)
    Vector3 正前=act 1.this.localToWorldDir(Vector3 0,0,-1)
    Float 偏移数=varf Long.炮塔模型'偏移.toFloat()
    Float 偏移数=fun float.multiply(var 偏移数:Float 60)
    varf Long.炮塔模型'偏移.addEqual(Long 1)
    Long 炮塔模型'偏移=fun long.mod(var 炮塔模型'偏移:Long 6)
    //每射击一轮之后的额外冷却
    if{fun long.equal(var 炮塔模型'偏移:Long 0)
      Float cd=fun float.multiply(var cd:Float 12)
    }
    if{fun long.equal(var 炮塔模型'偏移:Long 1)
      act 1.this.播放音效(String 机枪.ogg:Float 0.5)
    }
    //修正原坐标
    Vector3 偏移修正=fun vector3.rotateAround(var 正右:var 正前:var 偏移数)
    Vector3 子弹局部坐标偏移=fun vector3.add1(var 子弹局部坐标偏移:Vector3 0,1.5,0:var 偏移修正)
    Vector3 子弹世界方向=act 1.this.localToWorldDir(var 向前局部方向)
    Vector3 子弹世界坐标=act 1.this.localToWorldPos(var 子弹局部坐标偏移)
    //发射子弹
    Bool 发射成功=act 1.this.Launcher'指定坐标放置(var 子弹世界坐标:var 子弹世界方向:Long 2900:var 属性'玩家:Float 1:Float 0:Float 1:Bool 0:Float 0)
    //发射特效
    Vector3 特效局部坐标偏移=varf Vector3.局部坐标偏移.setLength(Float 2)
    Vector3 特效局部坐标偏移=fun vector3.add1(var 特效局部坐标偏移:Vector3 0,1.5,0:var 偏移修正)
    Vector3 特效世界方向=act 1.this.localToWorldDir(var 向前局部方向)
    Vector3 特效世界方向=fun vector3.multilply(var 特效世界方向:Float -1)
    Vector3 特效世界坐标=act 1.this.localToWorldPos(var 特效局部坐标偏移)
    Float 缩放=fun create.float(Float 50)
    Color 开火颜色=fun create.color(Color 255,152,0,255)
    Float 持续时间=fun create.float(Float 0.1)
    varf Device.map_handler.callFun5(String 发射开火特效:var 特效世界坐标:var 特效世界方向:var 缩放:var 开火颜色:var 持续时间)
    Float 炮塔模型'结束时间=fun float.add1(var 当前时间:Float 2:var cd)
    if{fun create.bool(var 发射成功)
      =act 1.this.Skills'Decrease(var key:Long 1)
      delay fun create.float(var cd)
    }
  }
}
Long 剩余弹药=act 1.this.Skills'GetValue(var key)
if{fun long.equal(var 剩余弹药:Long 0)
  delay fun create.float(Float 3)
  =act 1.this.Public'Damage(Float 9999:Long 0)
}
endcode