  varf Struct.player.set(String 连胜加成:var 连胜加成)
  //单独为败方第一添加积分
  if{fun long.notEqual(var team:var winner)
    String uid=varf Struct.player.getString(String id:Bool 1)
    if{fun long.equal(var winner:Long 1)
