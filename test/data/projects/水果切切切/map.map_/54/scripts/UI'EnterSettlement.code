      Float 瓜分连胜占比=fun long.division(var score:var 红队总积分)
    }
  }
  //计算胜方得到的连胜
  if{fun long.equal(var team:var winner)
    varf Long.streak.addEqual(Long 1)
    Float tmp=fun float.multiply(var 被瓜分败方连胜池:var 瓜分连胜占比)
    Long 抢夺连胜=varf Float.tmp.toLong()
