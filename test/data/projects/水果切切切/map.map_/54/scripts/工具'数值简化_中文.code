name:工具'数值简化_中文
comment:转为XX万或者XX亿
params:Long 数值
return:String ret
lines:
String ret=fun create.string(String )
//中文的
if{fun long.lt(var 数值:Long 10000)
  String ret=fun create.string(var 数值)
}
if{fun long.gte(var 数值:Long 10000)
  Float tmp=fun long.division(var 数值:Long 10000)
  Float tmp=fun float.round(var tmp:Float 2)
  String ret=fun string.add(var tmp:String  万)
}
if{fun long.gte(var 数值:Long 100000000)
  Float tmp=fun long.division(var 数值:Long 100000000)
  Float tmp=fun float.round(var tmp:Float 3)
  String ret=fun string.add(var tmp:String 亿)
}
endcode