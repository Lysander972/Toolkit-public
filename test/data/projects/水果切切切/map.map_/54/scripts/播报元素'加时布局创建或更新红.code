name:播报元素'加时布局创建或更新红
params:Struct player,Float 新增米数,Bool 达到上限
lines:
String uid=varf Struct.player.getString(String id:Bool 1)
Bool 已存在=fun create.bool(Bool 0)
Float 已有数值=fun create.float(Float 0)
//在展示队列里查找
Float index=varf List.播报'展示队列距离.count()
while{fun float.gt(var index:Float 0)
  varf Float.index.minusEqual(Float 1)
  Canvas canvas=varf List.播报'展示队列距离.readCanvas(var index)
  if{varf Canvas.canvas.exist()
    UIRect 读取背景=varf Canvas.canvas.readUIRect(String background)
    if{varf UIRect.读取背景.exist()
      String 持有者=varf UIRect.读取背景.customString(String 持有者标志位)
      if{fun string.equal(var uid:var 持有者)
        Bool 已存在=fun create.bool(Bool 1)
        UIRect background=varf Canvas.canvas.readUIRect(String background)
        fun break()
      }
    }
  }
}
if{fun create.bool(var 已存在)
  act 1101.this.播报元素'重置展示时间(var canvas)
  act 1101.this.播报元素'重置缩放动效计时(var canvas)
}
//在等待队列里查找
if{fun bool.not(var 已存在)
  Float index=varf List.播报'等待队列距离.count()
  while{fun float.gt(var index:Float 0)
    varf Float.index.minusEqual(Float 1)
    Canvas canvas=varf List.播报'等待队列距离.readCanvas(var index)
    if{varf Canvas.canvas.exist()
      UIRect 读取背景=varf Canvas.canvas.readUIRect(String background)
      if{varf UIRect.读取背景.exist()
        String 持有者=varf UIRect.读取背景.customString(String 持有者标志位)
        if{fun string.equal(var uid:var 持有者)
          Bool 已存在=fun create.bool(Bool 1)
          UIRect background=varf Canvas.canvas.readUIRect(String background)
          fun break()
        }
      }
    }
  }
}
if{fun create.bool(var 已存在)
  Float 已有数值=varf UIRect.读取背景.customFloat(String 米数标志位)
}
if{fun bool.not(var 已存在)
  fun ui.2dmode(Bool 1)
  Canvas canvas=fun create.canvas(Canvas canvas@1@@3@3)
  act 1101.this.播报元素'注册(var canvas:Float 1:Float 5)
  UIRect background=varf Canvas.canvas.readUIRect(String background)
  varf UIRect.background.active(Bool 0)
  varf UIRect.background.setCustomString(String 持有者标志位:var uid)
  act 1101.this.播报元素'设置缩放突出效果(var canvas:Bool 1)
  varf List.播报'等待队列距离.add(var canvas)
}
varf Float.已有数值.addEqual(var 新增米数)
varf UIRect.background.setCustomFloat(String 米数标志位:var 已有数值)
varf UIRect.background.setCustomFloat(String 优先级标志位:var 已有数值)
UILabel label=varf Canvas.canvas.readUILabel(String background/panel/label)
Float 简化显示=fun float.round(var 已有数值:Float 2)
