name:UI_功能面板'应用并刷新攻略提示显示
lines:
if{fun create.bool(var InGame)
  if{fun bool.not(var 功能开关'攻略提示)
    act 1101.this.UI_Tip'SetTip(Float -1)
  }
  if{fun create.bool(var 功能开关'攻略提示)
    act 1101.this.UI_Tip'SelectRandom()
  }
  UIRawImage 按钮图标=varf Canvas.GameUI.readUIRawImage(String root/topForPC/杂项设置区/攻略提示设置区/按钮/icon)
  UIRawImage 勾选图标1=varf Canvas.GameUI.readUIRawImage(String root/SettingsForMobile/屏蔽器2/子组件排版区/杂项设置区/攻略提示设置区/按钮/icon)
  varf UIRawImage.按钮图标.active(var 功能开关'攻略提示)
  varf UIRawImage.勾选图标1.active(var 功能开关'攻略提示)
}
endcode