Long 场外功能设置'分辨率选项=fun create.long(var 新分辨率选项)
act 1101.this.ButtonMenu'刷新分辨率按钮()
if{fun long.equal(var 场外功能设置'分辨率选项:Long 0)
  fun screen.setResolution(Float 760:Float 1334)
}
if{fun long.equal(var 场外功能设置'分辨率选项:Long 1)
  fun screen.setResolution(Float 1080:Float 1920)
}
if{fun long.equal(var 场外功能设置'分辨率选项:Long 2)
  fun screen.setResolution(Float 1440:Float 2660)
}
if{fun long.equal(var 场外功能设置'分辨率选项:Long 3)
  fun screen.setResolution(Float 2160:Float 3980)
}
if{fun long.equal(var 场外功能设置'分辨率选项:Long 4)
