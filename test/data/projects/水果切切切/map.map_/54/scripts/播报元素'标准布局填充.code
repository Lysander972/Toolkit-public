begincodeV2
name:播报元素'标准布局填充
params:Struct player,String text,Long width,Bool showIcon,Float 强度
return:Canvas canvas
lines:
Long team=varf Struct.player.getLong(String team:Bool 1)
fun ui.2dmode(Bool 1)
if{fun long.equal(var team:Long 1)
  Canvas canvas=fun create.canvas(Canvas canvas@1@)
}
if{fun long.equal(var team:Long 2)
  Canvas canvas=fun create.canvas(Canvas canvas@1@)
}
UIRect background=varf Canvas.canvas.readUIRect(String background)
varf UIRect.background.active(Bool 0)
Color 基础颜色=fun create.color(Color 255,255,255,255)
Color 弱化颜色=fun create.color(Color 192,192,192,129)
Color 实际颜色=varf Color.弱化颜色.lerp(var 基础颜色:var 强度)
UIRect panel=varf Canvas.canvas.readUIRect(String background/panel)
varf UIRect.panel.setColor(var 实际颜色)
if{fun long.equal(var width:Long 1)
  UIRect panel=varf Canvas.canvas.readUIRect(String background/panel)
  varf UIRect.panel.size(Vector3 600,145,0)
  varf UIRect.background.size(Vector3 600,145,0)
}
UILabel label=varf Canvas.canvas.readUILabel(String background/panel/label)
varf UILabel.label.text(var text)
UILabel label=varf Canvas.canvas.readUILabel(String background/panel/name)
String rawName=varf Struct.player.getString(String name:Bool 1)
String simpName=act 1101.this.限制昵称长度(var rawName)
varf UILabel.label.text(var simpName)
UIRawImage avatarICon=varf Canvas.canvas.readUIRawImage(String background/panel/mask/AvatarIcon)
String uid=varf Struct.player.getString(String id:Bool 1)
varf UIRawImage.avatarICon.SetDanmuAvatar(var uid)
UIRawImage icon=varf Canvas.canvas.readUIRawImage(String background/panel/icon)
varf UIRawImage.icon.active(var showIcon)
UIRawImage 动图=varf Canvas.canvas.readUIRawImage(String background/panel/rankicon)
Long 排行榜名次=fun create.long(Long -1)
if{varf Struct.player.contains(String 排行榜名次)
  Long 排行榜名次=varf Struct.player.getLong(String 排行榜名次:Bool 1)
}
Long 组编号=act 1101.this.动图'计算组编号(var 排行榜名次)
act 1101.this.动图'应用动图(var 动图:var 组编号)
act 1101.this.播报元素'设置缩放突出效果(var canvas:Bool 0)
endcode