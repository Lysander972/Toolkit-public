fun ui.2dmode(Bool 1)
Canvas canvas=fun create.canvas(Canvas canvas@1@@3)
UILabel label=varf Canvas.canvas.readUILabel(String background/panel/label)
String rawName=varf Struct.player.getString(String name:Bool 1)
String simpName=act 1101.this.限制昵称长度(var rawName)
String text=fun string.Format1(String %1加入玩法:var simpName)
varf UILabel.label.text(var text)
UIRect background=varf Canvas.canvas.readUIRect(String background)
varf UIRect.background.active(Bool 0)
Long team=varf Struct.player.getLong(String team:Bool 1)
if{fun long.equal(var team:Long 1)
  varf List.播报'等待队列左.add(var canvas)
}
if{fun long.equal(var team:Long 2)
  varf List.播报'等待队列右.add(var canvas)
}
act 1101.this.播报元素'注册(var canvas:Float 100:Float 3)
