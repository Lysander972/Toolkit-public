name:BarrageHandler'Comment
params:Dict msgObj,Struct player
lines:
String word=varf Dict.msgObj.readString(String word:Bool 0)
//测试专属
if{fun create.bool(var IsGM)
  Bool bool1=fun string.equal(var word:String 1)
  Bool bool2=fun string.equal(var word:String 2)
  Bool bool3=fun string.equal(var word:String 上)
  Bool bool4=fun string.equal(var word:String 下)
  Bool bool1=fun bool.or2(var bool1:var bool2:var bool3:var bool4)
  if{fun create.bool(var bool1)
    //gm模式为了方便测试，允许中途改变阵营
    =act 1101.this.Player'SelectFaction(var word:var player)
  }
  if{fun bool.not(var bool1)
    =act 1101.this.测试'模拟礼物(var word:var msgObj)
  }
}
//选队
Long team=varf Struct.player.getLong(String team:Bool 1)
if{fun long.lt(var team:Long 1)
  =act 1101.this.Player'SelectFaction(var word:var player)
}
//点赞
if{fun string.equal(var word:String 6)
  //评论6替代点赞，因为点赞有频率限制
  Struct player=act 1101.this.Player'InfoAutoFill(var player)
  act 1101.this.得到礼物'点赞(Long 10:var player)
}
if{fun string.equal(var word:String 666)
  //评论6替代点赞，因为点赞有频率限制
  Struct player=act 1101.this.Player'InfoAutoFill(var player)
  act 1101.this.得到礼物'点赞(Long 10:var player)
  Bool skillused=varf Struct.player.getBool(String skillused:Bool 1)
  if{fun bool.not(var skillused)
    if{fun long.equal(var team:Long 1)
      act 1101./Scenario.技能'添加到攻方玩家炮塔(String 1900:Long 1:var player)
    }
    if{fun long.equal(var team:Long 2)
      act 1101./Scenario.技能'添加到守方玩家炮塔(String 2900:Long 1:var player)
    }
    Bool skillused=fun create.bool(Bool 1)
    varf Struct.player.set(String skillused:var skillused)
  }
}
endcode