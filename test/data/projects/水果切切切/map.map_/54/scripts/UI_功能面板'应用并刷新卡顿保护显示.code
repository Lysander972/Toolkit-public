name:UI_功能面板'应用并刷新卡顿保护显示
lines:
//立即刷新卡顿检测状态
act 1101.this.标志位'更新卡顿检测()
if{fun create.bool(var InGame)
  UIRawImage 按钮图标=varf Canvas.GameUI.readUIRawImage(String root/topForPC/杂项设置区/卡顿保护设置区/按钮/icon)
  UIRawImage 勾选图标1=varf Canvas.GameUI.readUIRawImage(String root/SettingsForMobile/屏蔽器2/子组件排版区/杂项设置区/卡顿保护设置区/按钮/icon)
  varf UIRawImage.按钮图标.active(var 功能开关'卡顿保护)
  varf UIRawImage.勾选图标1.active(var 功能开关'卡顿保护)
}
endcode