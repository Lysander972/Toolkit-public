begincodeV2
name:UI_Tip'Animation
lines:
Float 当前时间=fun time.time()
Float 已用时间=fun float.minus(var 当前时间:var Tip'AniStart)
Float 比例=fun float.division(var 已用时间:Float 0.5)
Float 比例=fun float.clamp(var 比例:Float 0:Float 1)
Float 插值=fun float.SmoothStep(Float -180:Float 0:var 比例)
if{fun float.lt(var 比例:Float 0.5)
  Float 插值=fun float.add(var 插值:Float 180)
}
Vector3 转动=fun creatVariable.Vector3(Float 0:var 插值:Float 0)
varf UIRect.Tip'MainPanel.rot3D(var 转动)
if{fun bool.not(var Tip'Refreshed)
  if{fun float.gte(var 比例:Float 0.5)
    act 1101.this.UI_Tip'refresh()
    Bool Tip'Refreshed=fun create.bool(Bool 1)
  }
}
if{fun float.gte(var 比例:Float 1)
  Bool Tip'AniActivate=fun create.bool(Bool 0)
  fun script.skip()
}
endcode