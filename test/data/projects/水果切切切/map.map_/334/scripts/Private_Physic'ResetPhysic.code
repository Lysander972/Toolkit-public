Vector3 向前=fun vector3.multilply(var direct:Float -1)
//继续后续工作
varf Mech.Self.enablePhysics(var Physic'Enabled)
if{fun create.bool(var Physic'Enabled)
  varf Mech.Self.enableGravity(var Physic'Gravity)
  delay fun create.float(Float 0)
  Vector3 Physic'DefaultV=fun vector3.multilply(var direct:var Physic'SpeedExp)
  act 1.this.setRigidVelocity(var Physic'DefaultV)
  act 1.this.setRigidAngularVelocity(Vector3 0,0,0)
  delay fun create.float(Float 0)
