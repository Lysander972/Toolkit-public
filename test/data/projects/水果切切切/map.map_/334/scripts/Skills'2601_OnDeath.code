    Float 受伤乘数=fun float.division(var 目标权重:var 总权重)
    Float 受伤乘数=fun float.clamp(var 受伤乘数:Float 0.05:Float 1)
    Float 伤害值=fun float.multiply(var damage:var 受伤乘数)
    Float 伤害值=fun float.max(var 伤害值:Float 1)
    Float 当前HP=varf Device.core.callReturnFloat0(String Public'GetHP)
    //判断是否会导致死亡,如果是,则设置一个延迟时间
    if{fun float.gte(var 伤害值:var 当前HP)
      Device dev=varf Device.core.callReturnDevice0(String Public'GetMainDevice)
      Float mass=varf Device.dev.getMass()
      //对于低质量的生效
      if{fun float.lt(var mass:Float 1000)
        Bool 是否延迟=fun create.bool(Bool 1)
        Float 死亡延迟=fun math.rand(Float 0.5:Float 0.8)
        varf Device.core.callFun2(String Public'设置延迟死亡:var 是否延迟:var 死亡延迟)
      }
    }
    Long 伤害来源=fun create.long(Long 2)
    Vector3 伤害产生位置=act 1.this.受伤坐标计算(var Self:var target)
    Bool 是否暴击=fun create.bool(Bool 0)
    Bool 主动攻击=fun create.bool(Bool 1)
    varf Device.core.callFun5(String Public'Damage:var 伤害值:var 伤害来源:var 伤害产生位置:var 是否暴击:var 主动攻击)
  }
  varf Float.index.addEqual(Float 1)
}
