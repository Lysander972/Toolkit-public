name:积分简化
params:Long 积分
return:String ret
lines:
//中文的
if{fun long.lt(var 积分:Long 10000)
  String ret=fun create.string(var 积分)
}
if{fun long.gte(var 积分:Long 10000)
  Float tmp=fun long.division(var 积分:Long 10000)
  Float tmp=fun float.round(var tmp:Float 2)
  String ret=fun string.add(var tmp:String  万)
}
if{fun long.gte(var 积分:Long 100000000)
  Float tmp=fun long.division(var 积分:Long 100000000)
  Float tmp=fun float.round(var tmp:Float 3)
  String ret=fun string.add(var tmp:String 亿)
}
//外文的
fun break()
if{fun long.lt(var 积分:Long 1000)
  String ret=fun create.string(var 积分)
}
if{fun long.gte(var 积分:Long 1000)
  Float tmp=fun long.division(var 积分:Long 1000)
  Float tmp=fun float.round(var tmp:Float 2)
  String ret=fun string.add(var tmp:String K)
}
if{fun long.gte(var 积分:Long 1000000)
  Float tmp=fun long.division(var 积分:Long 1000000)
  Float tmp=fun float.round(var tmp:Float 3)
  String ret=fun string.add(var tmp:String M)
}
if{fun long.gte(var 积分:Long 1000000000)
  Float tmp=fun long.division(var 积分:Long 1000000000)
  Float tmp=fun float.round(var tmp:Float 4)
  String ret=fun string.add(var tmp:String B)
}
