name:Launcher'LaunchRandom
comment:随机散布发射子弹
params:Long type,Float aimedAngle,Float scatterAngle,Float offset,Struct player,Float HPMul,Float crit,Float initHp
return:Bool ret
lines:
Float minA=fun float.minus(var aimedAngle:var scatterAngle)
Float maxA=fun float.add(var aimedAngle:var scatterAngle)
Float minA=fun float.max(var minA:var 瞄准角度下限)
Float maxA=fun float.min(var maxA:var 瞄准角度上限)
Float randomA=fun math.rand(var minA:var maxA)
Vector3 bulletDir=act 1.this.计算'角度转方向(var randomA:Float 0)
Vector3 bulletDir=act 1.this.localToWorldDir(var bulletDir)
Bool ret=act 1.this.Launcher'Launch(var type:var bulletDir:var offset:var player:var HPMul:var crit:var initHp:Bool 0:Float 0)
endcode