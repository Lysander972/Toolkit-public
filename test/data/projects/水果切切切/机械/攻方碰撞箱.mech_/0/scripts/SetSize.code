begincodeV2
name:SetSize
params:Float width,Float length,Mech mech
lines:
Vector3 size=fun creatVariable.Vector3(var width:Float 0:var length)
Vector3 size=fun vector3.add(var size:Vector3 1e+03,1e+03,1e+03)
act 22./攻方传送带.setSize(var size)
//在地图上放置传送带碰撞体
Device target=varf Mech.mech.getCoreDevice()
//放置下面
Vector3 relative=fun creatVariable.Vector3(Float 0:Float -1000:Float 0)
Vector3 global=act 1.this.localToWorldPos(var relative)
Device new=fun map.dynAddDevice(var mech:Float 1:var global:Vector3 0,0,1:Vector3 0,1,0:Float 1:var target)
Float temp=fun float.add(var width:var length)
Vector3 size=fun creatVariable.Vector3(var width:Float 0:var temp)
Vector3 size=fun vector3.add(var size:Vector3 1e+03,1e+03,1e+03)
varf Device.new.callFun1(String setSize:var size)
varf Device.new.setLayer(Float 9)
varf Device.new.show(Bool 0)
varf Device.new.setMass(Float 0)
varf Device.new.switchCollider(Bool 1)
Device target=fun creatVariable.device(var new)
