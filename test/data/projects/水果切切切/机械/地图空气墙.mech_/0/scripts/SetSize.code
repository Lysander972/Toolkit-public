//计算各个墙的位置
Float 前墙z=fun float.multiply(var width:Float 0.5)
Float 前墙z=fun float.add1(var 前墙z:var length:Float 50)
Float 后墙z=fun create.float(Float -200)
Float z轴跨度=fun float.minus(var 前墙z:var 后墙z)
