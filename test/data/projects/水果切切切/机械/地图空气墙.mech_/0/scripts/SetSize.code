//获取变量
Mech self=act 1.this.getMech()
Device this=act 1.this.getDevice()
//放置下面
Vector3 relative=fun creatVariable.Vector3(Float 0:Float -500:Float 0)
Vector3 global=act 1.this.localToWorldPos(var relative)
Device new=fun map.dynAddDevice(var self:Float 1:var global:Vector3 0,0,1:Vector3 0,1,0:Float 1:var this)
varf Device.new.SetPhysicsMaterial(Float 0:Float 1:Float 1)
Float temp=fun float.add(var width:var length)
Vector3 size=fun creatVariable.Vector3(var width:Float 1000:var temp)
Vector3 size=fun vector3.add(var size:Vector3 2e+03,0,2e+03)
varf Device.new.callFun1(String setSize:var size)
varf Device.new.setLayer(Float 11)
varf Device.new.show(Bool 0)
varf Device.new.setMass(Float 0)
varf Device.new.switchCollider(Bool 1)
