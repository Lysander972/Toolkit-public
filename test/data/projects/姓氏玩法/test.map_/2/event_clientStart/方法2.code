Canvas 测试=fun create.canvas(Canvas canvas@1@@3)
UIRect 面板=varf Canvas.测试.readUIRect(String 滑动区域/滑动面板)
delay fun create.float(Float 0.1)
//原UI是500*500,放大到500*2000,应该基于原布局坐标向下移750像素抵消子UI的位置变化
varf UIRect.面板.size(Vector3 2e+03,500,0)
Vector3 布局坐标=varf UIRect.面板.getCanvasPos()
Vector3 布局坐标=fun vector3.add(var 布局坐标:Vector3 -750,0,0)
varf UIRect.面板.setCanvasPos(var 布局坐标)
