//旧版
Float 潜在选项1=fun long.division(var 原始value:Long 409600)
Float 潜在选项2=fun long.division(var 原始value:Long 102400)
Float 潜在选项2=fun float.max(var 潜在选项2:Float 1)
Float 潜在选项2=fun float.log(var 潜在选项2:Float 1.01)
Float 潜在选项2=fun float.lerp(var 潜在选项2:var 潜在选项1:Float 0.1)
Float 选用值=fun float.min(var 潜在选项1:var 潜在选项2)
//固定的高度修饰,无论高度多大都上移5距离
varf Float.选用值.addEqual(Float 15)
