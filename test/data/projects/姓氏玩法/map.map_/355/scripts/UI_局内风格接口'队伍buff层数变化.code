//空投
if{fun long.equal(var buff类型:Long 17)
  varf Mech.队伍模型.callFun1(String 开关空投加速特效:var 存在buff)
  //离场动画
  if{fun bool.and(var 播放入场离场动画:var 新状态无层数)
    Mech 绑定模型=varf Mech.队伍模型.customMech(String 空投buff模型)
    varf Mech.绑定模型.setCustomBool(String 开始离场:Bool 1)
    varf Mech.队伍模型.setCustomMech(String 空投buff模型:Mech )
  }
  //入场动画转移到交互事件
}
