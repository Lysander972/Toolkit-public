begincodeV2
name:内部'动图动效刷新
params:UIRawImage 动图
lines:
Float 当前时间=fun time.time()
Vector3 初始坐标=varf UIRawImage.动图.customVector3(String 初始坐标)
Bool 正向=varf UIRawImage.动图.customBool(String 正向)
Float 动图x周期=varf UIRawImage.动图.customFloat(String 动图x周期)
Float 动图y周期=varf UIRawImage.动图.customFloat(String 动图x周期)
Float 初始x相位=varf UIRawImage.动图.customFloat(String 初始x相位)
Float 初始y相位=varf UIRawImage.动图.customFloat(String 初始y相位)
Float 动画x幅度=varf UIRawImage.动图.customFloat(String 动画x幅度)
Float 动画y幅度=varf UIRawImage.动图.customFloat(String 动画y幅度)
Float x周期内时间=fun float.mod(var 当前时间:var 动图x周期)
Float y周期内时间=fun float.mod(var 当前时间:var 动图y周期)
Float x动画比例=fun float.division(var x周期内时间:var 动图x周期)
Float y动画比例=fun float.division(var y周期内时间:var 动图y周期)
Float x角度=fun float.multiply(var x动画比例:Float 360)
Float y角度=fun float.multiply(var y动画比例:Float 360)
Float x_sin=fun float.triangle.sin(var x角度)
Float y_sin=fun float.triangle.sin(var y角度)
Float x位移=fun float.multiply(var x_sin:var 动画x幅度)
Float y位移=fun float.multiply(var y_sin:var 动画y幅度)
Float x位移=fun float.add(var x位移:var 初始x相位)
Float y位移=fun float.add(var y位移:var 初始y相位)
//削弱原本的随机横向
Float x位移=fun float.multiply(var x位移:Float 0.3)
//改为冲刺的横向
Float 动图x冲刺周期=varf UIRawImage.动图.customFloat(String 动图x冲刺周期)
Bool 在冲刺=varf UIRawImage.动图.customBool(String 在冲刺)
Float x冲刺周期内时间=fun float.mod(var 当前时间:var 动图x冲刺周期)
Float 冲刺部分=fun create.float(Float 0.1)
Float 回弹部分=fun float.minus(var 动图x冲刺周期:var 冲刺部分)
if{fun float.lte(var x冲刺周期内时间:var 冲刺部分)
  Float x冲刺动画比例=fun float.division(var x冲刺周期内时间:var 冲刺部分)
  Float x冲刺动画比例=fun float.SmoothStep(Float 0:Float 1:var x冲刺动画比例)
  Bool 新冲刺状态=fun create.bool(Bool 1)
}
if{fun float.gt(var x冲刺周期内时间:var 冲刺部分)
  Float x冲刺周期内时间=fun float.minus(var x冲刺周期内时间:var 冲刺部分)
  Float x冲刺动画比例=fun float.division(var x冲刺周期内时间:var 回弹部分)
  Float x冲刺动画比例=fun float.SmoothStep(Float 0:Float 1:var x冲刺动画比例)
  Float x冲刺动画比例=fun float.minus(Float 1:var x冲刺动画比例)
  Bool 新冲刺状态=fun create.bool(Bool 0)
}
if{fun bool.xor(var 在冲刺:var 新冲刺状态)
  varf UIRawImage.动图.setCustomBool(String 在冲刺:var 新冲刺状态)
