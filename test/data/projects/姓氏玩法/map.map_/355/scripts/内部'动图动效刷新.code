        }
/*        if{fun long.equal(var 随机音效:Long 3)
/*          act 1101./主界面.播放音效(String 武器撞击4.ogg:Float 1)
        }
      }
    }
  }
}
if{fun create.bool(var 正向)
  Float x额外位移=fun float.multiply(var x冲刺动画比例:Float 200)
  Float x位移=fun float.add1(var x位移:var x额外位移:Float -200)
}
if{fun bool.not(var 正向)
  Float x额外位移=fun float.multiply(var x冲刺动画比例:Float -200)
  Float x位移=fun float.add1(var x位移:var x额外位移:Float 200)
}
Vector3 相对坐标=fun creatVariable.Vector3(var x位移:var y位移:Float 0)
Vector3 绝对坐标=fun vector3.add(var 相对坐标:var 初始坐标)
varf UIRawImage.动图.setCanvasPos(var 绝对坐标)
endcode