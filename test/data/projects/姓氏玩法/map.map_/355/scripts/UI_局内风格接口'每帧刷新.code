act 1101.this.内部'更新分摄像机窗口位置()
Float 需刷新数量=varf List.数值变化检测表.count()
if{fun float.gt(var 需刷新数量:Float 0)
  act 1101.this.内部'数值变化效果生成()
}
//刷新进度条
Float 激活队伍数量=varf List.激活队伍列表.count()
Float 序号=fun create.float(Float 0)
while{fun float.lt(var 序号:var 激活队伍数量)
  Struct 队伍=varf List.激活队伍列表.readStruct(var 序号)
  Long 队伍id=act 1101./弹幕.队伍结构'读取_id(var 队伍)
  String 字符串id=fun create.string(var 队伍id)
  Bool 是否创建=varf Dict.队伍UI映射.contains(var 字符串id)
  if{fun create.bool(var 是否创建)
    Struct 队伍映射=varf Dict.队伍UI映射.readStruct(var 字符串id:Bool 0)
    act 1101.this.内部'每帧刷新_更新队伍映射(var 队伍映射)
  }
  varf Float.序号.addEqual(Float 1)
}
