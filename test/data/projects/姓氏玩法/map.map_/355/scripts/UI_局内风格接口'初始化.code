color:255,0,0
name:UI_局内风格接口'初始化
params:UIRect 框架根节点_2D,UIRect 框架根节点_3D
lines:
act 1101./弹幕.UI_通用框架'载入背景图(String )
=varf UIRect.框架根节点_2D.exist()
=varf UIRect.框架根节点_3D.exist()
Bool 存在=varf Canvas.风格主布局.exist()
if{fun bool.not(var 存在)
  fun ui.2dmode(var 平面UI开关)
  Canvas 风格主布局=fun create.canvas(Canvas canvas@1局内组件_风格@)
  //绑定根节点
  UIRect 主布局根节点=varf Canvas.风格主布局.readUIRect(String 根节点)
  if{fun create.bool(var 平面UI开关)
    varf UIRect.框架根节点_2D.addSon(var 主布局根节点)
  }
  if{fun bool.not(var 平面UI开关)
    varf UIRect.框架根节点_3D.addSon(var 主布局根节点)
  }
  //获取列表引用
  List 激活队伍列表=act 1101./弹幕.队伍'获得激活队伍列表()
  //图表相关
  UIRect 图表节点=varf Canvas.风格主布局.readUIRect(String 根节点/图表)
  UIRect 图表基础图层=varf Canvas.风格主布局.readUIRect(String 根节点/图表/基础图层)
  UIRect 图表特效图层_悬浮=varf Canvas.风格主布局.readUIRect(String 根节点/图表/特效图层_悬浮)
  UIRect 图表特效图层_礼物=varf Canvas.风格主布局.readUIRect(String 根节点/图表/特效图层_礼物)
  UIRect 图表特效图层_全屏效果=varf Canvas.风格主布局.readUIRect(String 根节点/图表/特效图层_全屏效果)
  UIButton 拖动监听区=varf Canvas.风格主布局.readUIButton(String 根节点/拖动监听区)
  UIButton 队伍排行榜=varf Canvas.风格主布局.readUIButton(String 根节点/队伍排行榜)
/*  act 1101./弹幕.UI_局内'拖动面板_初始化(var 队伍排行榜:String 队伍排行榜1)
  UIRect 队伍排行榜面板=varf Canvas.风格主布局.readUIRect(String 根节点/队伍排行榜/滑动区域/队伍排行榜面板)
  varf UIRect.队伍排行榜面板.setCustomFloat(String 子组件数量:Float 0)
  UIButton 面板开关=varf Canvas.风格主布局.readUIButton(String 根节点/快捷设置面板/自动视角子面板/开关)
  varf UIButton.面板开关.clickCB0(String 回调'自动调整视角开关)
  UIButton 面板开关=varf Canvas.风格主布局.readUIButton(String 根节点/快捷设置面板/排序方式子面板/开关)
  varf UIButton.面板开关.clickCB0(String 回调'排序方式开关)
  act 1101.this.内部'自动调整视角开关刷新()
  act 1101.this.内部'排序方式开关刷新()
  UIButton 第一名弹窗=varf Canvas.风格主布局.readUIButton(String 根节点/第一名弹窗)
}
Mech 不可见碰撞体=act 1101./Scenario.Model'SetModel(Vector3 0,-99,0:Vector3 0,0,1:String 柱子模型)
varf Mech.不可见碰撞体.setLayer(Float 1)
