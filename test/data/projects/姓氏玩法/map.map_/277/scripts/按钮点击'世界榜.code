lines:
Canvas 世界榜UI=fun create.canvas(Canvas canvas@1@@3@3)
if{fun create.bool(var 已初始化)
  act 1101.this.按钮颜色刷新()
  act 1101.this.积分榜刷新()
}
if{fun bool.not(var 已初始化)
  act 1101.this.按钮点击'周榜()
  Bool 已初始化=fun create.bool(Bool 1)
}
Bool 是GM=act 1101./主界面.工具'是GM()
UIButton b=varf Canvas.世界榜UI.readUIButton(String panel/base/清空所有)
varf UIButton.b.active(var 是GM)
UIButton b=varf Canvas.世界榜UI.readUIButton(String panel/base/清理测试数据)
varf UIButton.b.active(var 是GM)
UIButton b=varf Canvas.世界榜UI.readUIButton(String panel/base/确认)
varf UIButton.b.active(Bool 0)
