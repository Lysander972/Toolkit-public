if{fun keyboard.keyDown2(Enum 1)
  Bool 开关面板=fun bool.not(var 开关面板)
  act 1101.this.开关调参面板(var 开关面板)
}
Bool 是否为GM=act 1101./主界面.工具'是GM()
if{fun create.bool(var 是否为GM)
  Float i=fun create.float(Float 0)
  Float N=varf List.参数调节列表.count()
  while{fun float.lt(var i:var N)
    Canvas UI=varf List.参数调节列表.readCanvas(var i)
    act 1101.this.刷新滑动条(var UI)
    Float i=fun float.add(var i:Float 1)
  }
}
