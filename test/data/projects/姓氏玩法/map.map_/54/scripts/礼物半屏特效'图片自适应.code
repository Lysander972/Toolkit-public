/*Vector3 图片尺寸=fun creatVariable.Vector3(var 图片宽度:var 图片高度:Float 0)
/*fun break()
Vector3 全屏UI=fun screen.uiSize()
Float 半屏宽度=varf Vector3.全屏UI.x()
Float 半屏高度=varf Vector3.全屏UI.y()
/*Float 半屏高度=fun float.multiply(var 半屏高度:Float 0.5)
Float 半屏比率=fun float.division(var 半屏宽度:var 半屏高度)
Float 图片比率=fun float.division(var 图片宽度:var 图片高度)
if{fun float.lt(var 图片比率:var 半屏比率)
  //图片更窄,使用全屏宽度
  Float 图片宽度=fun create.float(var 半屏宽度)
  Float 图片高度=fun float.division(var 图片宽度:var 图片比率)
}
if{fun float.gte(var 图片比率:var 半屏比率)
  //图片更宽
  Float 图片高度=fun create.float(var 半屏高度)
  Float 图片宽度=fun float.multiply(var 图片比率:var 图片高度)
}
Vector3 图片尺寸=fun creatVariable.Vector3(var 图片宽度:var 图片高度:Float 0)
endcode