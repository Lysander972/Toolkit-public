begincodeV2
color:123,255,0
name:队伍'施加效果_随机其他队伍
params:Struct 玩家,Long 效果层数,Float 每层速度变化,Float 每层数值变化,Float 持续时间,Long 互动事件和buff类型,Bool 延迟生效
return:Bool 设置成功
lines:
Bool 设置成功=fun create.bool(Bool 0)
//得到玩家队伍,如果玩家还没下场则没有效果
Struct 玩家队伍=act 1101.this.队伍'得到玩家队伍(var 玩家)
Bool 是队伍=act 1101.this.队伍结构'是队伍(var 玩家队伍)
if{fun bool.not(var 是队伍)
  fun break()
}
Long 玩家队伍id=act 1101.this.队伍结构'读取_id(var 玩家队伍)
//如果队伍数量太少不会生效
Float 激活队伍数量=varf List.局内'队伍_激活队伍列表.count()
if{fun float.lt(var 激活队伍数量:Float 2)
  fun break()
}
//不会对玩家自身队伍生效
Float 跳过序号=fun create.float(Float -1)
Float 序号=fun create.float(Float 0)
while{fun float.lt(var 序号:var 激活队伍数量)
  Struct 潜在目标队伍=varf List.局内'队伍_激活队伍列表.readStruct(var 序号)
  Long 潜在目标队伍id=act 1101.this.队伍结构'读取_id(var 潜在目标队伍)
  if{fun long.equal(var 潜在目标队伍id:var 玩家队伍id)
    Float 跳过序号=fun create.float(var 序号)
  }
  varf Float.序号.addEqual(Float 1)
}
//确定玩家队伍在全部队伍中的位置,这个位置会被跳过
Long 跳过序号L=varf Float.跳过序号.toLong()
//随机抽取,大于等于当前位置的序号+1作为补偿
Long 激活队伍数量L=varf Float.激活队伍数量.toLong()
Long 抽取范围=fun long.minus(var 激活队伍数量L:Long 2)
Long 目标序号=fun long.rand(Long 0:var 抽取范围)
//把玩家本身所在队伍扣掉
if{fun long.gte(var 目标序号:var 跳过序号L)
  varf Long.目标序号.addEqual(Long 1)
}
Float 目标序号F=varf Long.目标序号.toFloat()
//选中目标队伍
Struct 选中队伍=varf List.局内'队伍_激活队伍列表.readStruct(var 目标序号F)
if{act 1101.this.队伍结构'是队伍(var 选中队伍)
  act 1101.this.队伍'施加效果_封装(var 玩家:var 玩家队伍:var 选中队伍:var 效果层数:var 每层速度变化:var 每层数值变化:var 持续时间:var 互动事件和buff类型:var 延迟生效)
  Bool 设置成功=fun create.bool(Bool 1)
}
endcode