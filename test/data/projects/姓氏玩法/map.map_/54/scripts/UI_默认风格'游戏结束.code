//在0.5秒内快速弹出
Float 入场动效时长=fun create.float(Float 0.3)
Float 放大动画时长=fun float.multiply(var 入场动效时长:Float 0.6)
Float 缩小动画时长=fun float.minus(var 入场动效时长:var 放大动画时长)
Float 动画开始时间=fun time.scaleTime()
Float 已使用时间=fun create.float(Float 0)
while{fun float.lt(var 已使用时间:var 入场动效时长)
  if{fun float.lt(var 已使用时间:var 放大动画时长)
    Float 插值比例=fun float.division(var 已使用时间:var 放大动画时长)
    Float 缩放=fun float.SmoothStep(Float 0.01:Float 1.2:var 插值比例)
    varf UIRect.面板.scale(var 缩放)
  }
  if{fun float.gte(var 已使用时间:var 放大动画时长)
    Float 插值比例=fun float.minus(var 已使用时间:var 放大动画时长)
    Float 插值比例=fun float.division(var 插值比例:var 缩小动画时长)
    Float 缩放=fun float.SmoothStep(Float 1.2:Float 1:var 插值比例)
    varf UIRect.面板.scale(var 缩放)
  }
  delay fun create.float(Float 0)
  Float 当前时间=fun time.scaleTime()
  Float 已使用时间=fun float.minus(var 当前时间:var 动画开始时间)
}
varf UIRect.面板.scale(Float 1)
//倒计时控制逻辑
Float 当前时间=fun time.scaleTime()
Float 强制退出时间=fun float.add(var 当前时间:Float 10)
Bool 强制确认=fun float.gte(var 当前时间:var 强制退出时间)
Bool 手动确认=varf UIButton.确认按钮.customBool(String 点击)
Bool 退出=fun bool.or(var 强制确认:var 手动确认)
while{fun bool.not(var 退出)
  //倒计时显示刷新
  Float 剩余时间=fun float.minus(var 强制退出时间:var 当前时间)
  Float 特效角度=fun float.multiply(var 剩余时间:Float -2)
  varf UIRect.特效图.rot(var 特效角度)
  Float 特效缩放相位=fun float.multiply(var 剩余时间:Float -90)
  Float 缩放系数=fun float.triangle.sin(var 特效缩放相位)
  Float 缩放系数=fun float.abs(var 缩放系数)
  Float 缩放系数=fun float.lerp(Float 0.8:Float 1:var 缩放系数)
  varf UIRect.特效图.scale(var 缩放系数)
  Float 特效颜色插值相位=fun float.multiply(var 剩余时间:Float -120)
  Float 颜色插值系数=fun float.triangle.sin(var 特效颜色插值相位)
  Float 颜色插值系数=fun float.abs(var 颜色插值系数)
  Color 初始颜色=fun create.color(Color 255,255,255,255)
  Color 显示颜色=varf Color.初始颜色.lerp(Color 255,255,255,128:var 颜色插值系数)
  varf UIRect.特效图.setColor(var 显示颜色)
  Float 剩余时间=varf Float.剩余时间.ceiling()
  String 倒计时显示=fun string.Format1(String 本场积分榜@4%1秒@5:var 剩余时间)
  varf UILabel.确认按钮标题.text(var 倒计时显示)
  delay fun create.float(Float 0)
  Float 当前时间=fun time.scaleTime()
  Bool 强制确认=fun float.gte(var 当前时间:var 强制退出时间)
  Bool 手动确认=varf UIButton.确认按钮.customBool(String 点击)
  Bool 退出=fun bool.or(var 强制确认:var 手动确认)
}
//离场动画
Float 离场动效时长=fun create.float(Float 0.3)
Float 动画开始时间=fun time.scaleTime()
Float 已使用时间=fun create.float(Float 0)
while{fun float.lt(var 已使用时间:var 离场动效时长)
  Float 插值比例=fun float.division(var 已使用时间:var 离场动效时长)
  Float 纵向位置=fun float.SmoothStep(Float 0.5:Float 1.5:var 插值比例)
  Vector3 坐标=fun creatVariable.Vector3(Float 0.5:var 纵向位置:Float 0)
  varf UIRect.面板.pos(var 坐标)
  delay fun create.float(Float 0)
  Float 当前时间=fun time.scaleTime()
  Float 已使用时间=fun float.minus(var 当前时间:var 动画开始时间)
}
varf UIRect.根节点.del(Float 0)
