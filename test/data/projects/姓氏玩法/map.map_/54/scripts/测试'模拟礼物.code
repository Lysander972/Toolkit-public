begincodeV2
color:255,255,255
name:测试'模拟礼物
comment:用于使用聊天框模拟礼物
params:String 消息内容,Struct 玩家
return:Bool ok
lines:
//跳过字数不足情况
Float 字数=varf String.消息内容.length()
if{fun float.lt(var 字数:Float 3)
  fun break()
}
//判定礼物数
String 消息前缀=fun create.string(var 消息内容)
Long 礼物数=fun create.long(Long 1)
List 分割=varf String.消息内容.split(String  )
Float N=varf List.分割.count()
if{fun float.Approximately(var N:Float 2)
  String c=varf List.分割.readString(Float 1)
  Long 礼物数=varf String.c.toLong()
  String 消息前缀=varf List.分割.readString(Float 0)
  if{fun float.lt(var 字数:Float 3)
    fun break()
  }
}
Long 礼物数=fun long.max(var 礼物数:Long 1)
//判定礼物数
Bool ok=fun create.bool(Bool 0)
Long 礼物编号=fun create.long(Long -1)
if{fun string.equal(var 消息前缀:String 礼物1)
  Long 礼物编号=fun create.long(Long 0)
  Bool ok=fun create.bool(Bool 1)
}
if{fun string.equal(var 消息前缀:String 礼物2)
  Long 礼物编号=fun create.long(Long 1)
  Bool ok=fun create.bool(Bool 1)
}
if{fun string.equal(var 消息前缀:String 礼物3)
  Long 礼物编号=fun create.long(Long 2)
  Bool ok=fun create.bool(Bool 1)
}
if{fun string.equal(var 消息前缀:String 礼物4)
  Long 礼物编号=fun create.long(Long 3)
  Bool ok=fun create.bool(Bool 1)
}
if{fun string.equal(var 消息前缀:String 礼物5)
  Long 礼物编号=fun create.long(Long 4)
  Bool ok=fun create.bool(Bool 1)
}
if{fun string.equal(var 消息前缀:String 礼物6)
  Long 礼物编号=fun create.long(Long 5)
  Bool ok=fun create.bool(Bool 1)
}
if{fun string.equal(var 消息前缀:String 礼物7)
  Long 礼物编号=fun create.long(Long 6)
  Bool ok=fun create.bool(Bool 1)
}
if{fun string.equal(var 消息前缀:String 礼物8)
  Long 礼物编号=fun create.long(Long 7)
  Bool ok=fun create.bool(Bool 1)
}
if{fun create.bool(var ok)
  String uid=act 1101.this.玩家结构'读取_id(var 玩家)
  String name=act 1101.this.玩家结构'读取_name(var 玩家:Bool 0)
  String avatarUrl=act 1101.this.玩家结构'读取_avatarUrl(var 玩家)
  act 1101.this.测试'发送礼物消息_通用(var uid:var 礼物编号:var 礼物数:var avatarUrl:var name)
}
endcode