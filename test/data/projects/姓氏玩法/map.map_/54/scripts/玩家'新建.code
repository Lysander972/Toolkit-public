act 1101.this.玩家结构'设置_streak(var data:Long 0)
act 1101.this.玩家结构'设置_rank_completeness(var data:Bool 0)
//玩家的局内数据
Dict 新建字典=fun create.dict()
List 目标捣乱=fun create.list()
