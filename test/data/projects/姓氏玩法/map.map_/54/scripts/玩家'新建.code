Bool exist=varf Dict.局内'玩家_索引.contains(var id)
if{fun create.bool(var exist)
  Struct data=varf Dict.局内'玩家_索引.readStruct(var id:Bool 0)
  fun break()
}
Struct data=fun create.struct()
//玩家的基本信息
act 1101.this.玩家结构'设置_id(var data:var id)
