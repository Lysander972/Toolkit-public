if{fun bool.not(var init)
  List 已知姓氏列表=fun create.list()
  List 姓氏ID表=fun map.excelGetIDList2(String 姓氏表)
  Float 数量=varf List.姓氏ID表.count()
  Float 序号=fun create.float(Float 0)
  while{fun float.lt(var 序号:var 数量)
    Long ID=varf List.姓氏ID表.readLong(var 序号)
    String 姓=fun readExcel2_String(var ID:String 姓:String 姓氏表)
    varf List.已知姓氏列表.add(var 姓)
    varf Float.序号.addEqual(Float 1)
  }
  Float 数量=varf List.已知姓氏列表.count()
  Bool init=fun create.bool(Bool 1)
}
String 找到姓=fun create.string(String )
Float 字数=varf String.待判定.length()
if{fun float.gte(var 字数:Float 3)
  Float 截取长度=fun float.minus(var 字数:Float 2)
  String 片段=varf String.待判定.substring(Float 2:var 截取长度)
  Float 序号=fun create.float(Float 0)
  while{fun float.lt(var 序号:var 数量)
    String 姓=varf List.已知姓氏列表.readString(var 序号)
    if{fun string.equal(var 姓:var 片段)
      String 找到姓=fun create.string(var 姓)
      fun break()
    }
    varf Float.序号.addEqual(Float 1)
  }
}
