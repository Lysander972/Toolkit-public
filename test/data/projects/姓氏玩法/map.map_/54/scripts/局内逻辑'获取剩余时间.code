name:局内逻辑'获取剩余时间
return:Float 剩余时间
lines:
if{fun bool.not(var 局内'游戏中)
  Float 剩余时间=fun create.float(var 局内_游戏规则'本局时长)
}
if{fun bool.or(var 局内'游戏中:var 局内'已结算)
  Float 游戏结束时间=fun float.add(var 局内_游戏规则'开局时间:var 局内_游戏规则'本局时长)
  Float 当前时间=fun time.scaleTime()
  Float 剩余时间=fun float.minus(var 游戏结束时间:var 当前时间)
  if{fun create.bool(var 局内_游戏规则'强制结束)
    Float 剩余时间=fun create.float(Float 0)
  }
}
Float 剩余时间=fun float.max(var 剩余时间:Float 0)
endcode