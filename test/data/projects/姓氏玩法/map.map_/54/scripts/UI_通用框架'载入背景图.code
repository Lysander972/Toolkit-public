if{fun string.equal(var 图片名:String 背景图金色.webp)
  Float UI'背景图宽度=fun create.float(Float 800)
  Float UI'背景图高度=fun create.float(Float 800)
  varf UIRawImage.UI'背景图.loadPic(var 图片名)
  varf UIRawImage.UI'背景图.setColor(Color 103,103,103,255)
}
