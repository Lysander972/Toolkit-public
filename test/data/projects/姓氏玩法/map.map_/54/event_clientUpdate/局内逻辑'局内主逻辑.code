name:局内逻辑'局内主逻辑
lines:
if{act 1101.this.UI_局内'是否本界面()
  act 1101.this.礼物半屏特效'更新应用()
  act 1101.this.礼物半屏特效'更新绘制()
  //决战阶段检查
  act 1101.this.局内逻辑'决战阶段检查()
  //处理各玩家的待处理效果
  act 1101.this.局内逻辑'互动操作_处理全部玩家()
  //延迟效果注册信息的触发标记检查
  act 1101.this.局内逻辑'延迟效果_触发检查()
  //定时任务事件队列的到期检查
  act 1101.this.局内逻辑'定时任务事件队列_弹出到期事件并处理()
  //更新全部队伍的数值
  act 1101.this.局内逻辑'更新队伍数值()
  //更新排名检查
  act 1101.this.局内逻辑'更新队伍排名()
  //更新队内的玩家排名
  if{fun create.bool(var 局内'重排积分标志位)
    act 1101.this.局内逻辑'更新全部队伍内部积分排序()
    Bool 局内'重排积分标志位=fun create.bool(Bool 0)
  }
  //随后是获胜判断
  act 1101.this.游戏'获胜判定()
}
