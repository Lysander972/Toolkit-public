Long 后缀=fun create.long(Long 1)
while{fun long.lte(var 后缀:Long 21)
  String 名称=fun string.Format1(String 碎片%1.fbx:var 后缀)
  varf List.模型名称列表.add(var 名称)
  varf Long.后缀.addEqual(Long 1)
}
