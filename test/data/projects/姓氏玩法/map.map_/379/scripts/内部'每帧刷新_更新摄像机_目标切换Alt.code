if{fun create.bool(var 摄像机'存在手动操作)
  //只要有手动操作,那么就会强制取消跟随队伍,且以当前视角@4如果是跟随队伍则以队伍位置为准@5为基准进行调整
  Bool 摄像机'自动跟随中=fun create.bool(Bool 0)
  //然后把此虚拟位置转换为符合范围限制的
  Float 摄像机'看向位置序号=act 1101.this.工具'取模操作(var 基准值:var 场景'位置数量)
  //下一步检查看向位置,确定锁定位置是否需要更新
  Float 下取整=varf Float.摄像机'看向位置序号.floor()
  Float 摄像机'锁定位置=act 1101.this.工具'取模操作(var 下取整:var 场景'位置数量)
}
