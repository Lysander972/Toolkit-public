lines:
List 名称列表=varf Dict.队伍UI映射.names()
Float 数量=varf List.名称列表.count()
Float 循环=fun create.float(Float 0)
while{fun float.lt(var 循环:var 数量)
  String 字符串id=varf List.名称列表.readString(var 循环)
  Canvas 队伍UI布局=varf Dict.队伍UI映射.readCanvas(var 字符串id:Bool 0)
  UIRect 根节点=varf Canvas.队伍UI布局.readUIRect(String 根节点)
  varf UIRect.根节点.del(Float 0)
  varf Float.循环.addEqual(Float 1)
}
varf Dict.队伍UI映射.clear()
endcode