guid:c84e103aaef1485a94f1c97152a3e178
name:物体重用新
params:Mech 绑定柱子模型,Vector3 局部坐标偏移,Float 大小,Float 爆裂力量,Float 拉伸程度,List 模型名称列表,Float 转速大小
lines:
Float 创建时间=fun time.scaleTime()
Mech 绑定柱子模型_本地=fun creatVariable.mech(var 绑定柱子模型)
List 附加碎片列表=varf Mech.绑定柱子模型.customList(String 附加碎片列表)
Mech this=act 1.this.getMech()
varf List.附加碎片列表.add(var this)
Vector3 局部坐标偏移_本地=varf Vector3.局部坐标偏移.copy()
List 模型名称列表_本地=varf List.模型名称列表.ref()
Float y方向缩放=fun float.multiply(var 大小:var 拉伸程度)
Vector3 模型缩放=fun creatVariable.Vector3(var y方向缩放:var 大小:var 大小)
Vector3 朝向调整辅助向量=fun creatVariable.Vector3(var 拉伸程度:Float 1:Float 1)
Float 额外偏移量=fun create.float(Float 0)
/*Float 重力系数=fun float.division(Float -10:var 拉伸程度)
/*Float 重力系数=fun create.float(Float -10)
Float 重力系数=act 1.this.读取(String 重力系数:Float -10:Float -30:Float 10:Color 0,0,0,255)
Vector3 重力=fun creatVariable.Vector3(Float 0:var 重力系数:Float 0)
Mech this=act 1.this.getMech()
varf Mech.this.scale(var 大小)
varf Mech.this.enablePhysics(Bool 1)
Float 爆裂力度下限=fun float.multiply(var 爆裂力量:Float 0.5)
delay fun create.float(Float 0)
Float N=varf Mech.this.deviceNum()
Float i=fun create.float(Float 1)
while{fun float.lt(var i:var N)
  Device D=varf Mech.this.getDevice(var i)
  Float type=varf Device.D.typeID()
  if{fun float.Approximately(var type:Float 362)
    varf Device.D.setVelocity(Vector3 0,0,0)
    varf Device.D.setAngularVelocity(Vector3 0,0,0)
    varf Device.D.setPosKinematic(Vector3 0,-100,0)
    varf Device.D.setRotKinematic(Vector3 0,0,-1:Vector3 1,0,0)
  }
  varf Float.i.addEqual(Float 1)
}
act 1.this.模型坐标映射()
act 1.this.loopFun(String 模型坐标映射:Float 0)
delay fun create.float(Float 0)
Float N=varf Mech.this.deviceNum()
Float i=fun create.float(Float 1)
while{fun float.lt(var i:var N)
  Device D=varf Mech.this.getDevice(var i)
  Float type=varf Device.D.typeID()
  if{fun float.Approximately(var type:Float 362)
    Float x=fun math.rand(Float -0.5:Float 0.5)
    Float y=fun math.rand(Float -1:Float 1)
    Float y=fun float.division(var y:var 拉伸程度)
    Float z=fun math.rand(Float -0.5:Float 0.5)
    Vector3 off=fun creatVariable.Vector3(var x:var y:var z)
    Float 生效值=fun math.rand(var 爆裂力度下限:var 爆裂力量)
    Vector3 off=varf Vector3.off.setLength(var 生效值)
    varf Device.D.addForce(var off:Enum 2)
    Float x=fun math.rand(Float -1:Float 1)
    Float y=fun math.rand(Float -1:Float 1)
    Float z=fun math.rand(Float -1:Float 1)
    Vector3 转速=fun creatVariable.Vector3(var x:var y:var z)
/*    Float 生效值=fun math.rand(Float 0.1:Float 0.2)
    Vector3 转速=varf Vector3.转速.setLength(var 转速大小)
    varf Device.D.addTorque(var 转速:Enum 2)
  }
  varf Float.i.addEqual(Float 1)
}
delay fun create.float(Float 2.2)
act 1.this.DisableFun(String 模型坐标映射)
Float 附加碎片数量=varf List.附加碎片列表.count()
Float 序号=fun create.float(Float 0)
while{fun float.lt(var 序号:var 附加碎片数量)
  Mech 碎片=varf List.附加碎片列表.readMech(var 序号)
  if{varf Mech.碎片.isSame(var this)
    varf List.附加碎片列表.remove(var 序号)
    fun break()
  }
  varf Float.序号.addEqual(Float 1)
}
delay fun create.float(Float 0.1)
act 1.this.die()
endcode