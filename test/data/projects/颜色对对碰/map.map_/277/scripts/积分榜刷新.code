name:积分榜刷新
lines:
Dict dict=fun create.dict()
Long Num=fun create.long(Long 100)
varf Dict.dict.insert(String PageIndex:var 分页)
varf Dict.dict.insert(String Num:var Num)
async Dict ret=fun dynamicCallRet(String DanmuGetAllRank:var dict)
List Ranks=varf Dict.ret.readList(String Ranks:Bool 0)
Canvas 界面=fun create.canvas(Canvas canvas@1A2@@3)
UIRect 结算界面=varf Canvas.界面.readUIRect(String 结算界面)
UIRect base=varf Canvas.世界榜UI.readUIRect(String panel)
UIRect bottom=varf Canvas.世界榜UI.readUIRect(String panel/bottom)
varf UIRect.bottom.delAllChild()
varf UIRect.bottom.addSon(var 结算界面)
UIButton 确认=varf Canvas.界面.readUIButton(String 结算界面/确认)
varf UIButton.确认.clickCB1(String 按钮点击'删除UI:var base)
UIRect panel=varf Canvas.界面.readUIRect(String 结算界面/scroll/panel)
Float i=fun create.float(Float 0)
Float N=varf List.Ranks.count()
Float tmp=varf Long.分页.toFloat()
Float 序号偏移=fun float.multiply(var tmp:Float 100)
//根据连胜计算积分加成
while{fun float.lt(var i:var N)
  Dict D=varf List.Ranks.readDict(var i)
  String name=varf Dict.D.readString(String name:Bool 0)
  String id=varf Dict.D.readString(String uid:Bool 0)
  Long 连胜=varf Dict.D.readLong(String wins:Bool 0)
  Long 积分=varf Dict.D.readLong(String score:Bool 0)
  Canvas itemUI=fun create.canvas(Canvas canvas@1@)
  UIRect item=varf Canvas.itemUI.readUIRect(String item)
  UIButton button=varf Canvas.itemUI.readUIButton(String item/补偿)
  if{act 1101./弹幕.Utils'IsGM()
    varf UIButton.button.clickCB2(String 按钮点击'补偿:var id:var name)
  }
  varf UIRect.panel.addSon(var item)
  if{fun long.lte(var 连胜:Long 0)
    UIRect rect=varf Canvas.itemUI.readUIRect(String item/连胜)
    varf UIRect.rect.active(Bool 0)
  }
  if{fun long.gt(var 连胜:Long 0)
    String s=fun string.Format1(String %1连胜:var 连胜)
    UILabel label=varf Canvas.itemUI.readUILabel(String item/连胜/label)
    varf UILabel.label.text(var s)
  }
  UILabel 名次=varf Canvas.itemUI.readUILabel(String item/名次)
  Float rank=fun float.add1(var i:Float 1:var 序号偏移)
  varf UILabel.名次.text(var rank)
  UIRawImage rankIcon=varf Canvas.itemUI.readUIRawImage(String item/rankIcon)
  Bool 是前三=fun float.gt(Float 4:var rank)
  varf UIRawImage.rankIcon.active(var 是前三)
  if{fun create.bool(var 是前三)
    varf UILabel.名次.text(String )
    if{fun float.Approximately(var rank:Float 1)
      String s=fun create.string(String icon_color_medal_gold.png)
    }
    if{fun float.Approximately(var rank:Float 2)
      String s=fun create.string(String icon_color_medal_silver.png)
    }
    if{fun float.Approximately(var rank:Float 3)
      String s=fun create.string(String icon_color_medal_bronze.png)
    }
    varf UIRawImage.rankIcon.loadPic(var s)
  }
/*  String s=fun string.Format2(String %1@1%2:var name:var ID)
  UILabel 昵称=varf Canvas.itemUI.readUILabel(String item/昵称)
  if{fun string.equal(var name:String )
    String name=fun create.string(String [等待下次结算上传昵称])
  }
  varf UILabel.昵称.text(var name)
  UILabel 积分label=varf Canvas.itemUI.readUILabel(String item/积分)
  varf UILabel.积分label.text(var 积分)
  UILabel 世界排名label=varf Canvas.itemUI.readUILabel(String item/世界排名)
  varf UILabel.世界排名label.text(var rank)
  varf Float.i.addEqual(Float 1)
}
Vector3 size=varf UIRect.panel.getSize()
Float 宽度=varf Vector3.size.x()
UIRect scroll=varf Canvas.界面.readUIRect(String 结算界面/scroll)
act 1101.this.界面显示'滑动区域适配(var N:var 宽度:var panel:var scroll:Float 112:Float 3)
endcode