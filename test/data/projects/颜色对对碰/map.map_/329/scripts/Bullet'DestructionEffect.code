begincodeV2
name:Bullet'DestructionEffect
comment:摧毁时特效
params:Mech $obj,Long $type,Long $faction
lines:
Vector3 $pos=varf Mech.$obj.corePos()
if{fun long.equal(var $faction:Long 1)
  Color $color=fun create.color(Color 101,251,252,255,子弹-蓝色修正)
}
if{fun long.equal(var $faction:Long 2)
  Color $color=fun create.color(Color 254,224,100,255,子弹-红色修正)
}
if{fun long.equal(var $type:Long 0)
  act 336./粒子特效发射器.发射(var $pos:var $color:Float 0.2:Float 1)
  fun break()
  Long $rand=fun long.rand(Long 0:Long 1)
  Float $volume=fun create.float(Float 0.05)
  if{fun long.equal(var $rand:Long 0)
    act 1101./主界面.播放音效(String Metal Light 1.ogg:var $volume)
  }
  if{fun long.equal(var $rand:Long 1)
    act 1101./主界面.播放音效(String Metal Light 8.ogg:var $volume)
  }
}
if{fun long.equal(var $type:Long 1)
