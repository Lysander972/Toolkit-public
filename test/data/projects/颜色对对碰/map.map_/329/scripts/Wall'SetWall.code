begincodeV2
color:8,0,255
name:Wall'SetWall
params:Vector3 $pos,Vector3 $direction
return:Mech $obj
lines:
Float $index=varf List.WallUnused.count()
Bool $exist=fun float.gt(var $index:Float 0)
if{fun create.bool(var $exist)
  varf Float.$index.minusEqual(Float 1)
  Mech $obj=varf List.WallUnused.readMech(var $index)
  varf Mech.$obj.setActive(Bool 1)
  varf Mech.$obj.move(var $pos:Enum 0)
  varf Mech.$obj.rot(var $direction:Vector3 0,1,0)
  varf List.WallUnused.remove(var $index)
  varf List.WallUsing.add(var $obj)
}
if{fun bool.not(var $exist)
  Mech $obj=act 1101.this.Wall'New(var $pos:var $direction)
}
endcode