name:Map'Preheat
lines:
//预热子弹模型
act 1101.this.Map'PreheatBullet(Long 0:Long 0)
act 1101.this.Map'PreheatBullet(Long 1:Long 0)
act 1101.this.Map'PreheatBullet(Long 10:Long 0)
act 1101.this.Map'PreheatBullet(Long 20:Long 0)
act 1101.this.Map'PreheatBullet(Long 30:Long 0)
act 1101.this.Map'PreheatBullet(Long 40:Long 0)
act 1101.this.Map'PreheatBullet(Long 41:Long 0)
act 1101.this.Map'PreheatBullet(Long 50:Long 0)
act 1101.this.Map'PreheatBullet(Long 51:Long 0)
act 1101.this.Map'PreheatBullet(Long 60:Long 0)
//注册礼物模型
act 1101.this.GiftModel'RegisterType(String 礼物1蓝)
act 1101.this.GiftModel'RegisterType(String 礼物1红)
act 1101.this.GiftModel'RegisterType(String 礼物2蓝)
act 1101.this.GiftModel'RegisterType(String 礼物2红)
act 1101.this.GiftModel'RegisterType(String 礼物3蓝)
act 1101.this.GiftModel'RegisterType(String 礼物3红)
act 1101.this.GiftModel'RegisterType(String 礼物4蓝)
act 1101.this.GiftModel'RegisterType(String 礼物4红)
act 1101.this.GiftModel'RegisterType(String 礼物5蓝)
act 1101.this.GiftModel'RegisterType(String 礼物5红)
act 1101.this.GiftModel'RegisterType(String 礼物6蓝)
act 1101.this.GiftModel'RegisterType(String 礼物6红)
//注册子弹信息
act 1101.this.Bullet'RegisterBulletType(String 0:String 0:Long -1:Long -1)
act 1101.this.Bullet'RegisterBulletType(String 1:String 1:Long -1:Long -1)
act 1101.this.Bullet'RegisterBulletType(String 10:String 10:Long -1:Long -1)
act 1101.this.Bullet'RegisterBulletType(String 20:String 20:Long -1:Long -1)
act 1101.this.Bullet'RegisterBulletType(String 30:String 30:Long -1:Long -1)
act 1101.this.Bullet'RegisterBulletType(String 31:String 0:Long -1:Long -1)
act 1101.this.Bullet'RegisterBulletType(String 40:String 40:Long 15:Long 30)
act 1101.this.Bullet'RegisterBulletType(String 41:String 41:Long -1:Long -1)
act 1101.this.Bullet'RegisterBulletType(String 42:String 1:Long -1:Long -1)
act 1101.this.Bullet'RegisterBulletType(String 43:String 1:Long -1:Long -1)
act 1101.this.Bullet'RegisterBulletType(String 50:String 50:Long 9:Long 18)
act 1101.this.Bullet'RegisterBulletType(String 51:String 51:Long -1:Long -1)
act 1101.this.Bullet'RegisterBulletType(String 60:String 60:Long -1:Long -1)
act 1101.this.Bullet'RegisterBulletType(String 61:String 60:Long -1:Long -1)
delay fun create.float(Float 0)
act 1101.this.Bullet'ForceReclaimAll()
endcode