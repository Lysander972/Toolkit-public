private:1
color:0,138,255
name:Bullet'New
comment:创建一个普通子弹
params:String $modelKey,Vector3 $pos,Vector3 $dir
return:Mech $obj
lines:
String $modelName=fun string.add1(String 子弹:var $modelKey:String .mech)
List $bulletList=varf Struct.Bullet.getList(var $modelKey:Bool 0)
act 1110./子弹.changeMech(var $modelName)
Mech $obj=fun createAIMech(String 子弹:Float 0:var $pos:var $dir:Enum 1:Bool 0)
act 1101.this.Generic'MechPhysics(var $obj:Bool 0:Float 1)
varf List.$bulletList.add(var $obj)
endcode