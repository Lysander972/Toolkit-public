Player $playerObj=fun getCurrentPlayer()
Long $playerID=varf Player.$playerObj.id()
List $GMlist=fun map.excelGetIDList2(String GM名单)
Float $totalF=varf List.$GMlist.count()
Long $totalL=varf Float.$totalF.toLong()
Long $index=fun create.long(Long 0)
while{fun long.lt(var $index:var $totalL)
  Long $userID=fun readExcel2_Long(var $index:String 用户编号:String GM名单)
  if{fun long.equal(var $playerID:var $userID)
    Bool IsGM=fun create.bool(Bool 1)
    fun break()
  }
  Long $index=fun long.add(var $index:Long 1)
}
Bool key=fun keyboard.keyHeld2(Enum 51)
if{fun create.bool(var key)
  Bool IsGM=fun create.bool(Bool 1)
}
if{fun create.bool(var IsGM)
  act 1101./参数调节模块.初始化快捷调试面板()
}
