Struct $player=act 1101.this.Player'InfoAutoFill(var $player:var $msgObj)
Long $giftCount=varf Dict.$msgObj.readLong(String num:Bool 0)
String $giftType=varf Dict.$msgObj.readString(String gift:Bool 0)
