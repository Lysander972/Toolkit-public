name:UI'GamePlayerJoin
params:Struct $player
return:Bool ok
lines:
Bool ok=fun create.bool(Bool 1)
Long $rank=varf Struct.$player.getLong(String 排行榜名次:Bool 1)
Long $team=varf Struct.$player.getLong(String team:Bool 1)
String $uid=varf Struct.$player.getString(String id:Bool 1)
Bool 未上榜=fun long.lt(var $rank:Long 0)
Bool 百名以外=fun long.gte(var $rank:Long 100)
String $name=varf Struct.$player.getString(String name:Bool 1)
if{fun bool.or(var 未上榜:var 百名以外)
  String s=fun string.Format1(String %1加入玩法:var $name)
  Canvas topUI=fun create.canvas(Canvas canvas@1@)
  UIRect top=varf Canvas.topUI.readUIRect(String top)
  UILabel label=varf Canvas.topUI.readUILabel(String top/label)
  varf UILabel.label.text(var s)
  varf UIRect.top.del(Float 3)
  if{fun long.equal(var $team:Long 1)
    UIRect parent=varf Canvas.GameUI.readUIRect(String root/leftTop)
  }
  if{fun long.equal(var $team:Long 2)
    UIRect parent=varf Canvas.GameUI.readUIRect(String root/rightTop)
  }
  varf UIRect.parent.addSon(var top)
  Float num=varf UIRect.parent.sonNum()
  if{fun float.gt(var num:Float 2)
    varf UIRect.parent.delSon(Float 0)
  }
  fun break()
}
Mech M=fun createAIMech(String 玩家入场:Float 99:Vector3 0,0,0:Vector3 0,0,1:Enum 0:Bool 0)
varf Mech.M.callFun2(String 设置排名:var $rank:var $player)
