List 排行榜输入=fun create.list()
Float i=fun create.float(Float 0)
//根据连胜计算积分加成
while{fun float.lt(var i:var N)
  Struct $player=varf List.playerList.readStruct(var i)
  Long $team=varf Struct.$player.getLong(String team:Bool 0)
  Long $streak=varf Struct.$player.getLong(String streak:Bool 0)
  Long $score=varf Struct.$player.getLong(String score:Bool 0)
  Float 占比=fun create.float(Float 0)
  if{fun long.equal(var $team:Long 1)
    if{fun long.gt(var 蓝队总积分:Long 0)
      Float 占比=fun long.division(var $score:var 蓝队总积分)
    }
  }
  if{fun long.equal(var $team:Long 2)
    if{fun long.gt(var 红队总积分:Long 0)
      Float 占比=fun long.division(var $score:var 红队总积分)
    }
  }
  if{fun long.equal(var $team:var $winner)
    varf Long.$streak.addEqual(Long 1)
    Float tmp=fun float.multiply(var 败方礼物积分:var 占比)
    if{fun long.equal(var 比赛模式:Long 0)
      Float tmp=fun float.multiply(var 败方连胜池:var 占比)
      Long 抢夺连胜=varf Float.tmp.toLong()
      varf Long.$streak.addEqual(var 抢夺连胜)
      varf Struct.$player.set(String 抢夺连胜:var 抢夺连胜)
    }
  }
  if{fun long.notEqual(var $team:var $winner)
    if{fun long.equal(var 比赛模式:Long 0)
      Float tmp=varf Long.$streak.toFloat()
      //失败扣除40%的连胜
      Float tmp=fun float.multiply(var tmp:Float 0.6)
      Long $streak=varf Float.tmp.toLong()
    }
  }
  if{fun long.gt(var $streak:Long 0)
    Float addRate=act 1101.this.连胜积分加成(var $streak)
    Float _积分=varf Long.$score.toFloat()
    Float tmp=fun float.multiply(var _积分:var addRate)
    Float tmp=varf Float.tmp.ceiling()
    Long 连胜加成=varf Float.tmp.toLong()
    varf Long.$score.addEqual(var 连胜加成)
    varf Struct.$player.set(String 连胜加成:var 连胜加成)
  }
  if{fun long.equal(var $team:var $winner)
    Float tmp=varf Long.$totalScore.toFloat()
    Float tmp=fun float.multiply(var tmp:var 占比)
    Long 抢夺积分池=varf Float.tmp.toLong()
    varf Long.$score.addEqual(var 抢夺积分池)
    varf Struct.$player.set(String 抢夺积分池:var 抢夺积分池)
  }
  Dict D=fun create.dict()
  String uid=varf Struct.$player.getString(String id:Bool 1)
  varf Dict.D.insert(String uid:var uid)
  varf Dict.D.insert(String score:var $score)
  varf Dict.D.insert(String wins:var $streak)
  Float $teamF=varf Long.$team.toFloat()
  varf Dict.D.insert(String team:var $teamF)
  String name=varf Struct.$player.getString(String name:Bool 1)
  varf Dict.D.insert(String name:var name)
  Bool bLose=fun long.notEqual(var $team:var $winner)
  varf Dict.D.insert(String bLose:var bLose)
  varf List.排行榜输入.add(var D)
  varf Float.i.addEqual(Float 1)
}
