begincodeV2
color:255,0,0
name:Generic'PlayAnimation
params:String $modelKey,String $text,Struct $player,Bool $skipUI,Long $mode
lines:
String ModelKey=fun create.string(var $modelKey)
if{fun bool.not(var $skipUI)
  Long $team=varf Struct.$player.getLong(String team:Bool 0)
  if{fun long.equal(var $team:Long 1)
    Canvas $itemUI=fun create.canvas(Canvas canvas@1@)
  }
  if{fun long.equal(var $team:Long 2)
    Canvas $itemUI=fun create.canvas(Canvas canvas@1@)
  }
  UILabel $label=varf Canvas.$itemUI.readUILabel(String panel/label)
  varf UILabel.$label.text(var $text)
  String $uid=varf Struct.$player.getString(String id:Bool 0)
  String $nick=varf Struct.$player.getString(String name:Bool 0)
  UILabel $label=varf Canvas.$itemUI.readUILabel(String panel/name)
  String $nick=act 1.this.限制昵称长度(var $nick)
  varf UILabel.$label.text(var $nick)
  UIRawImage $avatarICon=varf Canvas.$itemUI.readUIRawImage(String panel/mask/AvatarIcon)
  varf UIRawImage.$avatarICon.SetDanmuAvatar(var $uid)
  UIRect $panel=varf Canvas.$itemUI.readUIRect(String panel)
  Canvas $mainUI=fun findCanvas(String 主UI)
  if{fun long.equal(var $team:Long 1)
    UIRect $parent=varf Canvas.$mainUI.readUIRect(String root/leftTop)
  }
  if{fun long.equal(var $team:Long 2)
    UIRect $parent=varf Canvas.$mainUI.readUIRect(String root/rightTop)
  }
  Float 子节点=varf UIRect.$parent.sonNum()
  if{fun float.gt(var 子节点:Float 1)
    varf UIRect.$parent.delSon(Float 0)
  }
  varf UIRect.$parent.addSon(var $panel)
}
act 1.this.Generic'PlayAnimationAdapter(var $mode)
delay fun create.float(Float 3)
if{fun bool.not(var $skipUI)
  if{varf UIRect.$panel.exist()
    varf UIRect.$panel.del(Float 0)
  }
}
delay fun create.float(Float 3)
act 1.this.Generic'Reclaim()
endcode