# 全仓库文本文件强制 LF。
# text=auto 让 Git 只规范化文本文件；eol=lf 禁止 checkout 成 CRLF。
* text=auto eol=lf
*.patch whitespace=-trailing-space

# 二进制文件禁止 Git 做 EOL/编码转换。
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.bmp binary
*.svg binary
*.pdf binary
*.zip binary
*.gz binary
*.dll binary
*.exe binary
*.so binary
*.dylib binary
*.class binary
*.jar binary
*.war binary
*.wasm binary
*.pdb binary
*.bin binary
*.gguf filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
*.fbx binary
*.psd binary
*.ogg binary
*.mp4 binary
*.xlsx binary
*.canvas binary
*.mech binary
*.map binary
res/architecture/pi/package.json -text
