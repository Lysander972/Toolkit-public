specification {
  element system
  element container
  element document
  tag doc
  tag build
  tag test
  tag tool
  tag common
  tag acl
  tag gap
  tag todo
  tag runtime
  tag external
}
model {
  tools = system '自举检查工具' {
    #tool
    description '拥有仓库治理、检视与正式 CLI；只读检查现役源码，不接管产品运行时与包管理。'
    metadata {
      sourcePath 'tools'
      checks 'selfcheck'
      testStrategy 'high'
      files ['tools/tsconfig.json', 'tools/likec4.config.json', 'tools/**/*.c4', 'eslint.config.mjs', 'vitest.config.mjs', 'stryker.config.mjs', 'knip.config.ts']
    }
    cli = container 'CLI 与进程边界' {
      #tool
      description '装配项目检查与统一需求图检视的执行、输入和报告；规则分析由所属模块提供，标准工具由 pnpm scripts 直接执行。'
      metadata {
        sourcePath 'tools/cli'
        testStrategy 'high'
        files ['tools/cli/*.ts']
      }
    }
    architecture = container '架构模型解析' {
      #common
      description '解析聚合 C4，分析文件归属、依赖、源码声明与环境变量边界；不另建架构清单。'
      metadata {
        sourcePath 'tools/governance'
        testStrategy 'high'
        files ['tools/governance/*.ts']
      }
    }
    coding = container 'Java 风格规则' {
      #common
      description '通过 TypeScript AST 校验项目编码纪律；不修改受检源码。'
      metadata {
        sourcePath 'tools/lint/style'
        testStrategy 'high'
        files ['tools/lint/style/*.ts']
      }
    }
    tests = container '自身回归测试' {
      #test
      description '验证治理规则与真实 CLI 行为；夹具隔离，不改产品源码。'
      metadata {
        sourcePath 'test/modules/tools'
        files ['test/modules/tools/*.ts']
      }
    }
    testing = container '测试夹具' {
      #common
      description '提供隔离 Git 行为夹具；不承载正式检视状态。'
      metadata {
        sourcePath 'tools/testing'
        files ['tools/testing/*.ts']
      }
    }
    hooks = container 'Git 钩子转发' {
      #tool
      description '纯转发薄壳：零判定逻辑，全部判定经唯一入口 cli'
      metadata { files ['tools/git-hooks/*'] }
    }
    requirement_documents = document '新版需求图与文档环境' {
      #doc
      description '原文、解读、决策及关系共用 Sphinx-Needs TOML；uv 锁定正式文档环境。'
      metadata { files ['requirements/*.rst', 'requirements/*.toml', 'requirements/*.json', 'requirements/conf.py', 'requirements/gherkin_extract.py', 'requirements/uv.lock', 'requirements/.pharaoh/verdicts/*.json', 'requirements/.pharaoh/receipts/*.json'] }
    }
    test_metrics = document '模块测试指标基线' {
      #doc
      description '显式 record 写入的官方覆盖率与变异实测基线，check 只读比较。'
      metadata { files ['tools/test-metrics.json'] }
    }
  }
  repository = system '仓库工程基础' {
    description '拥有仓库配置与开发入口；原生工具负责安装和构建，不承载产品业务。'
    build = container 'pnpm 与依赖锁定' {
      #build
      description '声明根依赖、锁定、类型与构建入口和 CI；成员配置继承根配置。StrykerJS core、Vitest runner 与 TypeScript checker 执行增量变异测试，fast-check 负责属性测试，按需启用 Vitest coverage-v8 进行覆盖率评估；根 scripts 执行模块指标棘轮，精确版本由根包清单和锁文件持有。'
      metadata {
        files ['package.json', 'pnpm-lock.yaml', 'pnpm-workspace.yaml', 'tsconfig.base.json', 'vite.config.mjs', 'preview.config.mjs', '.github/workflows/ci.yml', '.github/workflows/audit.yml', '.github/pull_request_template.md']
      }
    }
    instructions = container '开发指引' {
      #doc
      description '提供开发纪律和入口导航；架构事实只引用 C4，不复制模块定义。'
      metadata {
        files ['AGENTS.md', 'README.md', 'LICENSE', '.agents/skills/*/SKILL.md']
      }
    }
    git = container '版本控制' {
      #common
      description '声明忽略、属性与子模块定位；生命周期由原生 Git 管理。'
      metadata { files ['.gitignore', '.gitattributes'] }
    }
    editor = container '编辑器配置' {
      #common
      description '声明开发编辑器格式与工作区选项；推荐 VS Code ESLint 扩展以执行仓库现役 ESLint 配置，不作为产品运行配置。'
      metadata { files ['.editorconfig', '.prettierignore', '.vscode/*.json'] }
    }
  }
  specifications = system '工具链规范' {
    description '登记实现合同与验证依据；只约束 C4 已定义的架构，不建立另一套模块。'
    tooling = container '治理契约' {
      #doc
      description '约束治理检查与检视行为；模型定义架构，规范定义实现验收。'
      metadata {
        specPath 'requirements/sources/toolchain'
        files ['requirements/sources/toolchain/spec.md']
      }
    }
    layout = container '文件布局契约' {
      #doc
      description '约束文件登记与配置继承的检查行为；具体归属只读 C4。'
      metadata {
        specPath 'requirements/sources/repo-layout'
        files ['requirements/sources/repo-layout/spec.md']
      }
    }
    development = container '开发与协作契约' {
      #doc
      description '约束开发操作、授权与 CI 调度；hooks、审计存储与登记算法引用治理契约。'
      metadata {
        specPath ['requirements/sources/dev-tooling', 'requirements/sources/git-workflow']
        files ['requirements/sources/dev-tooling/spec.md', 'requirements/sources/git-workflow/spec.md']
      }
    }
    runtime = container 'Toolkit 运行时合同' {
      #doc
      description '约束 Host、协议和服务的运行行为；服务边界以 C4 为准。'
      metadata {
        specPath 'requirements/sources/toolkit-runtime'
        files ['requirements/sources/toolkit-runtime/spec.md']
      }
    }
    workspace_files = container '工程文件合同' {
      #doc
      description '约束工程文件 IO、监听与路径行为；不拥有运行时工程数据。'
      metadata {
        specPath 'requirements/sources/workspace-files'
        files ['requirements/sources/workspace-files/spec.md']
      }
    }
    hjson = container 'Hjson 统一格式合同' {
      #doc
      description '约束 Hjson 解析和写出保真；格式合同不定义 IO 归属。'
      metadata {
        specPath 'requirements/sources/hjson-format'
        files ['requirements/sources/hjson-format/*.md']
      }
    }
    entities = container '第二层实体基础设施合同' {
      #doc
      description '约束实体更新、身份和提交行为；实体状态由现役实体模块拥有。'
      metadata {
        specPath 'requirements/sources/file-entities'
        files ['requirements/sources/file-entities/spec.md']
      }
    }
    host_configuration = container '保留 Host 配置合同' {
      #doc
      description '约束配置输入的读取行为；不引入第二配置来源。'
      metadata {
        specPath 'requirements/sources/host-configuration'
        files ['requirements/sources/host-configuration/spec.md']
      }
    }
    bescript = container 'BEScript 内部格式' {
      #doc
      description '约束文本、AST 和 TS 转换的保真行为；不承担 Host 生命周期。'
      metadata {
        specPath 'requirements/sources/bescript-format'
        files ['requirements/sources/bescript-format/*.md']
      }
    }
    canvas_render = container 'Canvas 渲染规范' {
      #doc
      description '约束 Canvas 显示与字段映射行为；渲染模块关系由 C4 定义。'
      metadata {
        specPath 'openspec/specs/canvas-render'
        files ['openspec/specs/canvas-render/*.md']
      }
    }
    vscode_frontend = container 'VS Code 前端职责' {
      #doc
      description '约束前端交互与配置行为；模块职责与依赖只引用架构图。'
      metadata {
        specPath 'openspec/specs/vscode-frontend'
        files ['openspec/specs/vscode-frontend/*.md']
      }
    }
    canvas = container 'Canvas 转换合同' {
      #doc
      description '约束四种 Canvas 表示的纯格式转换，以及工作区六向转换服务的结果隔离、缓存、资源核对与生命周期。'
      metadata {
        specPath 'requirements/sources/canvas-conversion'
        files ['requirements/sources/canvas-conversion/*.md']
      }
    }
    preview = container '静态预览与发布合同' {
      #doc
      description '约束静态预览产物与发布验证；不成为运行时产品入口。'
      metadata { specPath 'openspec/specs/preview' files ['openspec/specs/preview/*.md'] }
    }
    analysis = container '工程分析合同' {
      #doc
      description '约束纯函数符号表、零件方法局部变量和调用图。'
      metadata { specPath 'requirements/sources/analysis' files ['requirements/sources/analysis/*.md'] }
    }
  }
  toolkit = system 'Toolkit TypeScript 产品' {
    description '拥有工程 Host、实体与业务服务及接入合同；前端与渲染器按声明边界消费。'
    metadata { testStrategy 'high' }
    configuration = container '产品类型检查配置' {
      #build
      description '声明产品 TypeScript 检查范围并继承根选项；不提供运行时配置。'
      metadata { files ['src/toolkit/tsconfig.json'] }
    }
    project_model = container '工程格式纯计算包' {
      #build
      description '提供工程格式数据合同和纯计算；不持有 IO、Host 或实体运行状态。'
      metadata { files ['src/toolkit/project_model/package.json'] }
      logic = container '工程设置、路径、GUID 与权威逻辑实体' {
        #common
        description '解析工程设置、路径、GUID 与逻辑实体合同；输入由调用方提供，不读取工程。'
        metadata {
          sourcePath 'src/toolkit/project_model'
          files ['src/toolkit/project_model/*.ts']
        }
      }
      tests = container '工程格式测试' {
        #test
        description '验证工程格式纯计算的合法、非法与保真行为；不修改源夹具。'
        metadata {
          sourcePath 'test/modules/toolkit-project-model'
          files ['test/modules/toolkit-project-model/*.ts']
        }
      }
    }
    script = container 'BEScript 纯计算包' {
      #build
      description '数据合同与三层纯转换设计分开登记；纯转换函数不读取工程或拥有跨请求缓存，TS 视图转换服务持有缓存状态并传入完整语义依据'
      metadata { files ['src/toolkit/script/package.json'] }
      text = container '原版文本层' {
        description '第一层文本输入：读取 .code 版本、头部和正文原文；词汇和有限转义是唯一语言基础，正文语法只能由第一层转换解释'
        vocabulary = container '类型与转义' {
          #common
          description '定义 BEScript 词汇类型与有限转义；不解析控制结构或读取工程。'
          metadata {
            sourcePath 'src/toolkit/script/vocabulary'
            files ['src/toolkit/script/vocabulary/*.ts']
          }
        }
        code_file = container '.code 文件' {
          #common
          description '解析文件版本、头部与原始正文；正文语义交由第一层转换。'
          metadata {
            sourcePath 'src/toolkit/script/code_file'
            files ['src/toolkit/script/code_file/*.ts']
          }
        }
      }
      ast = container '局部 AST 层' {
        description '第一层解析产物和第二层源码输入；文件版本、脚本头与语句树，不携带引用身份或 TS 输出位置，绑定从语义树派生'
        local_ast = container '局部 AST' {
          #common
          description '承载局部脚本语句与源码布局；不保存跨工程身份或进程缓存。'
          metadata {
            sourcePath 'src/toolkit/script/local_ast'
            files ['src/toolkit/script/local_ast/*.ts']
          }
        }
      }
      context = container '零件上下文层' {
        description '第二层业务输入与反向输出：结构化元数据、变量和唯一有序脚本组。调用方显式提供工程身份、仓库关联、跨零件目标和平台数据，转换不得现场读工程'
        device_context = container '全局变量、零件元数据与零件上下文' {
          #common
          description '承载调用方提供的变量、元数据和脚本关联；不现场查询工程。'
          metadata {
            sourcePath 'src/toolkit/script/device_context'
            files ['src/toolkit/script/device_context/*.ts']
          }
        }
      }
      conversion = container '三层纯转换设计' {
        description '组织文本、语义与官方 TS 装配的纯转换；服务缓存与 IO 留给调用方。'
        first = container 'BEScript 文本与局部 AST 转换' {
          #common
          description 'Issue 45 的实现归属：唯一正文词法、控制结构、调用与反向序列化入口；依赖文本合同和局部 AST，不依赖 Host'
          metadata {
            sourcePath 'src/toolkit/script/conversion'
            files ['src/toolkit/script/conversion/*.ts']
          }
        }
        second = container 'Context 与官方 TS AST 业务转换' {
          #common
          description 'Issue 46 的实现归属：DeviceTsConverter 组合零件外壳、全局变量与组，单向调用 MethodMapping 完成方法来源、签名、可见性及正文双向映射；变量、调用和 Canvas 各由所属映射负责。仅消费 Context 与显式语义输入，不读取工程或缓存；可接受第三层传入的同身份官方方法节点以避免重复生成，不持有缓存或失效规则'
          metadata {
            sourcePath 'src/toolkit/script/ts_conversion'
            files ['src/toolkit/script/ts_conversion/*.ts']
          }
        }
        third = container '官方 TS 解析打印与局部装配' {
          #common
          description 'Issue 47 的实现归属：官方 parser、factory、printer 和有独立差分依据的局部片段装配；缓存状态由 TS 转换服务显式传入，无进程全局状态，无 BEScript 业务解释'
          metadata {
            sourcePath 'src/toolkit/script/ts_text'
            files ['src/toolkit/script/ts_text/*.ts']
          }
        }
      }
      tests = container 'BEScript 格式测试' {
        #test
        description '验证脚本纯转换、布局与语义保真；不维护 Host 状态。'
        metadata {
          sourcePath 'test/modules/toolkit-script'
          files ['test/modules/toolkit-script/*.test.ts']
        }
      }
      test_support = container 'TS 视图测试输入' {
        #common
        description '构造显式零件 Context 与平台依据供转换测试使用；无 IO、缓存或运行时状态。'
        metadata {
          sourcePath 'test/modules/toolkit-script-fixtures'
          files ['test/modules/toolkit-script-fixtures/*.ts']
        }
      }
    }
    config = container '配置来源抽象与实现' {
      #build
      description '定义只读配置来源合同；默认值由前端原生配置声明。'
      metadata { files ['src/toolkit/config/package.json'] }
      logic = container '只读配置来源' {
        #common
        #todo
        description '提供统一只读 ConfigSource、ToolkitConfig 和资产凭据端口；PiConfigSource 在本模块解释官方显式输入，VS Code 的具体 WorkspaceConfiguration 适配由 frontend.plugin 承载。两种入口各自注入唯一来源，默认值由宿主原生声明，凭据按远端执行边界读取。'
        metadata {
          todo '基础与资产配置合同已声明；Pi 参数和具体资产来源接入待实现，PiConfigSource.read 明确失败'
          sourcePath 'src/toolkit/config'
          files ['src/toolkit/config/*.ts']
        }
      }
      tests = container '配置来源测试' {
        #test
        description '验证配置读取与原生前端来源；不复制默认值来源。'
        metadata {
          sourcePath 'test/modules/toolkit-config'
          files ['test/modules/toolkit-config/*.ts']
        }
      }
    }
    host = container '工作区 Host' {
      #build
      description '拥有单工作区服务生命周期、共享装配与受控入口；领域事实由实体服务提供。共享文件和 Canvas 测试资源由 test_support 单独承载，供各现役测试主动持有和释放。'
      metadata { files ['src/toolkit/package.json'] }
      logic = container 'Host 组合根与受控入口' {
        #common
        #todo
        description '唯一 Effect ManagedRuntime；工作区服务通过原生 Layer 共享装配，请求和快照绑定 Host Scope；受控入口接收具名请求与取消信号，由 Host 主动分派，工程状态经实体层读取。'
        metadata {
          todo '具名请求、资产与语言入口已分派；主动刷新链等待完整实体结果，业务执行保持 TODO'
          sourcePath 'src/toolkit/host'
          files ['src/toolkit/host/*.ts']
        }
      }
      tests = container 'Host 行为测试' {
        #test
        description '验证 Host 启动、请求、快照和释放；资源隔离，不改源夹具。'
        metadata {
          sourcePath 'test/modules/toolkit-host'
          files ['test/modules/toolkit-host/*.test.ts']
        }
      }
      test_support = container '文件行为测试资源' {
        #common
        description '创建独占文件测试资源并交付真实文件服务；调用方主动持有和关闭。Canvas 资源在调用方 Scope 中装配实体和转换服务并逆序释放；保留实际写入统计与只读语料发现。'
        metadata {
          sourcePath 'test/modules/toolkit-file-support'
          files ['test/modules/toolkit-file-support/*.ts']
        }
      }
    }
    files = container '第一层：文件管理与监听' {
      #common
      description '持有唯一工程根并提供原始字节、实际元数据、目录枚举及四类文件变更原语；实体层唯一编排工程业务 IO。仅有一份工作区 Effect Cache 管理有界字节内容，键为含 revision 的 FileMetadata；Chokidar 提供实际变化目录批次；Host 在工作区 Scope 内装配并单一消费监听，文件层不解析实体或驱动上层业务。'
      metadata {
        sourcePath 'src/toolkit/files'
        files ['src/toolkit/files/*.ts']
      }
    }
    entities = container '第二层：工程实体' {
      #todo
      #common
      description '工程文件是唯一权威；本层从文件重读形成 MST 工作区快照、GUID 和声明关联，调用语义装配形成格式实体和完整读取基准。FormatEntity 是全部格式及派生视图实体的共同抽象根；DeviceEntity、ScriptEntity、CanvasEntity 与 ToolkitEntity 直接继承，TS/HTML 视图经 ToolkitEntity 继承根约束。读取入口提供完整基准，编辑和反向转换沿用同一基准。拥有 Schematics 提交并在提交后重新读取文件，向上层交付只读结果；按唯一派生归属划分源重读目录与视图纠偏路径，由 Host 主动调度。TODO：完整语义装配、固定输入依赖读取、派生视图写出及变化分类。'
      metadata {
        todo '完整语义读取、装配、派生视图发布与变化分类保持 TODO 明确失败；完整读取基准和源事件隔离的输入输出合同已声明'

        sourcePath 'src/toolkit/entities'
        files ['src/toolkit/entities/*.ts']
      }
    }
    semantic = container '语义装配（设计）' {
      #todo
      #common
      description '由实体层单侧调用的无状态纯装配：SdkDocument 以同一结构化 JSON 合同导入导出平台数据与文档，SemanticAssembly 消费同次工程逻辑快照、符号及调用分析和该平台数据，输出完整零件 Context 和转换依据。复用既有身份、Context 及转换类型；部署资源读取归宿主组合根，工程读取和依赖基准归实体层，不执行 IO、不重复分析或持有注册表缓存。'
      metadata {
        todo 'SDK JSON 双向合同与 SemanticAssembly.assemble 已声明；权威源导出、包内文档装配、导入校验和纯语义装配保持 TODO'
        sourcePath 'src/toolkit/semantic'
        files ['src/toolkit/semantic/*.ts']
      }
    }
    conversion = container '仅缓存状态的转换服务' {
      description '组织共享转换缓存与完整语义输入；工程文件是唯一权威，实体层负责文件派生快照和写入。'
      canvas = container 'Canvas 与 HTML 片段双向转换' {
        #common
