views {
  view index {
    title '01 · 产品总览'
    include frontend
    include toolkit
    include pure
    include canvas
  }
  view runtime of toolkit {
    title '02 · Toolkit Runtime'
    include toolkit.*
  }
  view workspace_services of toolkit {
    title '02a · 工作区三层与业务服务'
    include toolkit.host.logic
    include toolkit.files
    include toolkit.entities
    include toolkit.semantic
