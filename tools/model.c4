  view frontend of frontend {
    title '03 · VS Code 前端'
    include frontend.*
  }
  view pure_functions of pure {
    title '04 · 业务纯计算'
    include pure.*
  }
  view canvas of canvas {
    title '05 · Canvas 渲染产品'
    include canvas.*
    include renderer.*
  }
  view tooling of tools {
    title '10 · 开发治理'
    include tools.*
  }
  view repository of repository {
    title '11 · 仓库基础'
    include repository.*
  }
  view specifications of specifications {
    title '12 · 工具链规范'
    include specifications.*
  }
  view documentation of documentation {
    title '13 · 产品文档'
    include documentation.*
  }
  view legacy of legacy {
