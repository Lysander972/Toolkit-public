{
  "$schema": "res/schemas/package.json",
  "name": "toolkit-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "description": "Toolkit 产品与治理工具",
  "prettier": {
    "tabWidth": 2,
    "singleQuote": true,
    "semi": false,
    "endOfLine": "lf",
    "printWidth": 100
  },
  "devDependencies": {
    "@actions/expressions": "0.3.61",
    "@actions/workflow-parser": "0.3.61",
    "@ast-grep/napi": "0.45.3",
    "@cucumber/gherkin": "42.0.1",
    "@cucumber/cucumber": "13.3.0",
    "@cucumber/messages": "34.2.1",
    "@effect/platform-node": "4.0.0",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@likec4/language-server": "1.59.3",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@pixi-spine/base": "4.0.6",
    "@pixi-spine/runtime-3.8": "4.0.6",
    "@storybook/react-vite": "10.6.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@toolkit/canvas": "workspace:*",
    "@types/hjson": "2.4.6",
    "@types/istanbul-lib-coverage": "2.0.6",
    "@types/node": "24.11.1",
    "@types/picomatch": "4.0.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/write-file-atomic": "4.0.3",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "@xmldom/xmldom": "0.9.12",
    "ajv": "8.20.0",
    "canvaskit-wasm": "0.42.0",
    "dependency-cruiser": "18.2.0",
    "effect": "4.0.0",
    "esbuild": "0.28.1",
    "escape-string-regexp": "4.0.0",
    "eslint": "10.10.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "74.0.0",
    "fast-check": "4.10.2",
    "gpt-tokenizer": "4.0.0",
    "happy-dom": "20.14.5",
    "hjson": "3.2.2",
    "istanbul-lib-coverage": "3.2.2",
    "knip": "6.35.1",
    "likec4": "1.59.3",
    "mutation-testing-metrics": "3.9.0",
    "mutation-testing-report-schema": "3.9.0",
    "npm-run-all2": "8.0.4",
    "picomatch": "4.0.7",
    "pino": "10.4.0",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "read-excel-file": "9.3.10",
    "smol-toml": "1.6.1",
    "storybook": "10.6.1",
    "tsx": "4.23.13",
    "type-fest": "4.41.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "unocss": "66.7.5",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "write-file-atomic": "7.0.0",
    "yaml": "2.9.1",
    "zod": "4.6.4"
  },
  "scripts": {
    "prepare": "pnpm workspace:install && pnpm requirements:prepare",
    "workspace:install": "tsx --no-cache tools/cli/main.ts install",
    "check": "tsx --no-cache tools/cli/main.ts check",
    "check:architecture": "tsx --no-cache tools/cli/main.ts architecture",
    "check:format": "prettier --check --cache --cache-location _build/prettier/cache \"tools/**/*.ts\" \"src/toolkit/**/*.ts\" \"src/canvas_render/**/*.ts\" \"test/modules/**/*.{ts,tsx}\" \"src/frontend/**/*.{ts,tsx}\" \"src/preview/**/*.{ts,tsx}\" \"res/**/*.json\" \"src/**/*.json\" \"*.json\" \"*.mjs\" \"README.md\" \".github/**/*.md\" knip.config.ts",
    "format": "prettier --write \"tools/**/*.ts\" \"src/toolkit/**/*.ts\" \"src/canvas_render/**/*.ts\" \"test/modules/**/*.{ts,tsx}\" \"src/frontend/**/*.{ts,tsx}\" \"src/preview/**/*.{ts,tsx}\" \"res/**/*.json\" \"src/**/*.json\" \"*.json\" \"*.mjs\" \"README.md\" \".github/**/*.md\" knip.config.ts",
    "check:types": "tsc --noEmit -p tools/tsconfig.json --incremental --tsBuildInfoFile _build/tsc/check.tsbuildinfo",
    "check:lint": "TSX_DISABLE_CACHE=1 eslint tools src/toolkit src/canvas_render test/modules src/frontend src/preview knip.config.ts --cache --cache-strategy content --cache-location _build/eslint/cache --max-warnings 0",
    "check:dead-code": "JITI_FS_CACHE=false TSX_DISABLE_CACHE=1 knip --config knip.config.ts",
    "check:submodules": "tsx --no-cache tools/cli/main.ts gitlinks",
    "check:workspace": "tsx --no-cache tools/cli/main.ts workspace",
    "sync:submodules": "tsx --no-cache tools/cli/main.ts submodules",
    "check:commit": "tsx --no-cache tools/cli/main.ts commit-check",
    "requirements": "tsx --no-cache tools/cli/main.ts requirements",
    "requirements:prepare": "pnpm requirements prepare",
    "requirements:check": "pnpm requirements check",
    "requirements:diff": "pnpm requirements diff",
    "requirements:impact": "pnpm requirements ubc agent impact",
    "requirements:build": "pnpm requirements build local",
    "requirements:verify": "pnpm requirements verify",
    "requirements:verify:head": "pnpm requirements verify HEAD",
    "requirements:context": "pnpm requirements ubc agent context",
    "requirements:bdd": "tsx --no-cache tools/cli/main.ts requirements bdd",
    "check:ci": "pnpm exec run-p --max-parallel 3 --npm-path pnpm check check:schemas check:submodules && pnpm test:metrics",
    "check:schemas": "tsx --no-cache tools/cli/main.ts check:schemas",
    "test": "pnpm build:frontend:plugin && pnpm build:preview && TSX_DISABLE_CACHE=1 vitest run --configLoader native",
    "test:coverage": "pnpm build:frontend:plugin && pnpm build:preview && TSX_DISABLE_CACHE=1 vitest run --configLoader native --coverage",
    "test:mutation": "TSX_DISABLE_CACHE=1 stryker run stryker.config.mjs",
    "build:mutation:sandbox": "git init --quiet && pnpm install --offline --frozen-lockfile --ignore-scripts && pnpm requirements:prepare",
    "test:metrics": "pnpm test:coverage && pnpm test:mutation && pnpm check:metrics",
    "check:metrics": "tsx --no-cache tools/cli/main.ts metrics",
    "build:canvas-render-types": "tsc -p tools/tsconfig.json --noEmit false --declaration --emitDeclarationOnly --rootDir . --outDir _build/canvas_render/types --incremental --tsBuildInfoFile _build/canvas_render/types.tsbuildinfo",
    "build:architecture": "likec4 build tools --base /MechToolkit/architecture/ --use-hash-history --build-webcomponent=false --title \"Toolkit 架构\" -o _build/preview/site/architecture",
    "build:canvas-render": "esbuild src/canvas_render/CanvasRenderer.ts --bundle --format=esm --platform=node --target=node20 --packages=external --outfile=_build/canvas_render/CanvasRenderer.mjs",
    "build:preview": "vite build --configLoader native --config preview.config.mjs && tsx --no-cache src/preview/build/main.ts && CACHE_DIR=_build storybook build --config-dir src/preview/storybook --output-dir _build/preview/site/preview --disable-telemetry && pnpm build:architecture",
    "build:preview:assets": "tsx --no-cache src/preview/build/assets.ts",
    "serve:preview": "vite preview --configLoader native --config preview.config.mjs",
    "check:message": "tsx --no-cache tools/cli/main.ts message",
    "pull-request:check": "tsx --no-cache tools/cli/main.ts pull-request-check",
    "build:frontend:plugin": "esbuild src/frontend/plugin/extension.ts --bundle --platform=node --format=esm --main-fields=module,main --target=node20 --banner:js=\"import { createRequire as createBundleRequire } from 'node:module'; import { fileURLToPath as bundleFileURLToPath } from 'node:url'; import { dirname as bundleDirname } from 'node:path'; const require = createBundleRequire(import.meta.url); const __filename = bundleFileURLToPath(import.meta.url); const __dirname = bundleDirname(__filename);\" --external:vscode --outfile=_build/frontend/extension.mjs",
    "build:frontend:ui": "vite build --configLoader native --config vite.config.mjs",
    "build:frontend": "pnpm build:frontend:plugin && pnpm build:frontend:ui"
  }
}
